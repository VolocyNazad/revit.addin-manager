<ui:FluentWindow x:Class="AddinManager.Gallery.WpfUi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="AddinManager — WPF-UI gallery" Width="1080" Height="720"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="AddinManager — WPF-UI gallery" />

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12">
      <ComboBox Width="130" SelectedIndex="2">
        <ComboBoxItem>Revit 2027</ComboBoxItem>
        <ComboBoxItem>Revit 2026</ComboBoxItem>
        <ComboBoxItem>Revit 2025</ComboBoxItem>
        <ComboBoxItem>Revit 2021</ComboBoxItem>
      </ComboBox>
      <ui:TextBox Width="220" Margin="8,0,0,0" PlaceholderText="Поиск плагина…" />
      <ui:Button Margin="8,0,0,0">Обновить</ui:Button>
      <ui:Button Margin="8,0,0,0">+ Группа</ui:Button>
      <ui:Button Margin="8,0,0,0" Click="OnShowToast">Тост Revit (демо)</ui:Button>
      <ui:Button Margin="8,0,0,0" Click="OnThemeSystem">System</ui:Button>
      <ui:Button Margin="8,0,0,0" Click="OnThemeLight">Light</ui:Button>
      <ui:Button Margin="8,0,0,0" Click="OnThemeDark">Dark</ui:Button>
      <ui:Button Margin="8,0,0,0" Appearance="Primary" IsEnabled="False">Запустить Revit</ui:Button>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,0,12,8">
      <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">Группы:</TextBlock>
      <ui:Button>User</ui:Button>
      <ui:Button Margin="8,0,0,0">Machine</ui:Button>
      <ui:Button Margin="8,0,0,0">Группа 1</ui:Button>
      <ui:Button Margin="8,0,0,0">Группа 2</ui:Button>
      <ui:Button Margin="8,0,0,0">Без группы</ui:Button>
    </StackPanel>

    <Grid Grid.Row="3" Margin="12,0,12,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>

      <ListView Grid.Column="0" Margin="0,0,8,0" SelectionMode="Single">
        <ListViewItem>
          <StackPanel Orientation="Horizontal">
            <ui:ToggleSwitch IsChecked="True" VerticalAlignment="Top" />
            <StackPanel Margin="8,0,0,0">
              <TextBlock FontWeight="SemiBold">Revit.Linter.addin</TextBlock>
              <TextBlock Opacity="0.7" TextTrimming="CharacterEllipsis">Volocy • Линтер моделей Revit: проверки проекта и семейств, отчеты…</TextBlock>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Border CornerRadius="10" Padding="8,2,8,2" BorderThickness="1" BorderBrush="Gray">
                  <TextBlock FontSize="11">Machine</TextBlock>
                </Border>
                <Border CornerRadius="10" Padding="8,2,8,2" Margin="6,0,0,0" BorderThickness="1" BorderBrush="Gray">
                  <TextBlock FontSize="11">Вне группы</TextBlock>
                </Border>
                <Border CornerRadius="10" Padding="8,2,8,2" Margin="6,0,0,0" BorderThickness="1" BorderBrush="Gray">
                  <TextBlock FontSize="11">Группа 1</TextBlock>
                </Border>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ListViewItem>
        <ListViewItem>
          <StackPanel Orientation="Horizontal">
            <ui:ToggleSwitch IsChecked="True" VerticalAlignment="Top" />
            <StackPanel Margin="8,0,0,0">
              <TextBlock FontWeight="SemiBold">pyRevit.addin</TextBlock>
              <TextBlock Opacity="0.7" TextTrimming="CharacterEllipsis">pyRevitLabs • RAD environment for Autodesk Revit: скрипты, тулбар…</TextBlock>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Border CornerRadius="10" Padding="8,2,8,2" BorderThickness="1" BorderBrush="Gray">
                  <TextBlock FontSize="11">User</TextBlock>
                </Border>
                <Border CornerRadius="10" Padding="8,2,8,2" Margin="6,0,0,0" BorderThickness="1" BorderBrush="Gray">
                  <TextBlock FontSize="11">2 записи</TextBlock>
                </Border>
                <Border CornerRadius="10" Padding="8,2,8,2" Margin="6,0,0,0" BorderThickness="1" BorderBrush="Gray">
                  <TextBlock FontSize="11">Application + Command</TextBlock>
                </Border>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ListViewItem>
        <ListViewItem>
          <StackPanel Orientation="Horizontal">
            <ui:ToggleSwitch VerticalAlignment="Top" />
            <StackPanel Margin="8,0,0,0">
              <TextBlock FontWeight="SemiBold">Enscape.addin</TextBlock>
              <TextBlock Opacity="0.7" TextTrimming="CharacterEllipsis">Enscape • Real-time rendering and visualization plugin for Revit…</TextBlock>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Border CornerRadius="10" Padding="8,2,8,2" BorderThickness="1" BorderBrush="Gray">
                  <TextBlock FontSize="11">Machine</TextBlock>
                </Border>
                <Border CornerRadius="10" Padding="8,2,8,2" Margin="6,0,0,0" BorderThickness="1" BorderBrush="Gray">
                  <TextBlock FontSize="11">Группа 2</TextBlock>
                </Border>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ListViewItem>
      </ListView>

      <ui:CardControl Grid.Column="1" Header="Редактор: pyRevit.addin">
        <StackPanel Margin="8">
          <ui:ToggleSwitch IsChecked="True" Content="Отдельный контекст (2026+)" />
          <TextBlock Margin="0,8,0,2">ContextName</TextBlock>
          <ui:TextBox Text="pyRevit" />
          <TextBlock Margin="0,8,0,2">Name</TextBlock>
          <ui:TextBox Text="pyRevit" />
          <TextBlock Margin="0,8,0,2">Assembly *</TextBlock>
          <ui:TextBox Text="pyRevit\pyRevit.dll" />
          <TextBlock Margin="0,8,0,2">AddInId (GUID) *</TextBlock>
          <ui:TextBox Text="xxxxxxxx-xxxx-xxxx-xxxx-000000000001" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <ui:Button Appearance="Primary">Сохранить</ui:Button>
            <ui:Button Margin="8,0,0,0">Отменить</ui:Button>
          </StackPanel>
        </StackPanel>
      </ui:CardControl>
    </Grid>

    <ui:InfoBar x:Name="Toast" Grid.Row="1" Grid.RowSpan="3"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                Title="Revit запущен." Message="Переключение заблокировано."
                Severity="Warning" IsOpen="False" IsClosable="True" />
  </Grid>
</ui:FluentWindow>
