<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Токены подсветки AvalonEdit (см. MarkupView). Прикладные, живут с приложением.
        Ключи один в один с Themes/App/Dark.xaml.
    -->
    <SolidColorBrush x:Key="MarkupTagBrush" Color="#3B6E93" />
    <SolidColorBrush x:Key="MarkupAttributeNameBrush" Color="#8A6425" />
    <SolidColorBrush x:Key="MarkupAttributeValueBrush" Color="#3F7A55" />
    <SolidColorBrush x:Key="MarkupMetaBrush" Color="#8A8A8A" />
</ResourceDictionary>
