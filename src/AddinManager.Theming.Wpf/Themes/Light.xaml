<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FAFAFA" />
    <!-- AppForegroundBrush сюда не кладём: это алиас на Fluent-кисть TextFillColorDarkPrimaryBrush,
         его надёжнее брать через FindResource — см. ThemeDictionaries.Apply. -->
    <SolidColorBrush x:Key="EditorAccentBrush" Color="White" />
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#E5E5E5" />

    <!-- Предупреждения в одном стиле: желтый полупрозрачный фон + более яркая рамка
         (баннеры панелей, строчная ошибка списка, баннер Revit, тултипы иконок). -->
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#33FFC107" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#E6A700" />
    <SolidColorBrush x:Key="WarningTitleBrush" Color="#684D00" />

    <!-- Подсветка синтаксиса в редакторе разметки (см. MarkupView) — приглушённая палитра,
         подобранная под общий монохромный стиль приложения, а не библиотечные VS-цвета AvalonEdit. -->
    <SolidColorBrush x:Key="MarkupTagBrush" Color="#3B6E93" />
    <SolidColorBrush x:Key="MarkupAttributeNameBrush" Color="#8A6425" />
    <SolidColorBrush x:Key="MarkupAttributeValueBrush" Color="#3F7A55" />
    <SolidColorBrush x:Key="MarkupMetaBrush" Color="#8A8A8A" />
</ResourceDictionary>




