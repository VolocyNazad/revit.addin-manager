<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#202020" />
    <!--
        AppForegroundBrush сюда не кладём: это алиас на Fluent-кисть TextFillColorLightPrimaryBrush,
        его надёжнее брать через FindResource — см. ThemeDictionaries.Apply.
    -->
    <SolidColorBrush x:Key="EditorAccentBrush" Color="#454545" />
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#2D2D2D" />

    <!--  Подписи полей тултипа — сплошным цветом: гашение через Opacity даёт "смазанные" края.  -->
    <SolidColorBrush x:Key="TooltipLabelBrush" Color="#ABABAB" />

    <!--
        Предупреждения в одном стиле: желтый полупрозрачный фон + более яркая рамка
        (баннеры панелей, строчная ошибка списка, баннер Revit, тултипы иконок).
    -->
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#33FFC107" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#E6A700" />
    <SolidColorBrush x:Key="WarningTitleBrush" Color="#FFFFFF" />

    <!--
        Подсветка синтаксиса в редакторе разметки (см. MarkupView) — приглушённая палитра,
        подобранная под общий монохромный стиль приложения, а не библиотечные VS-цвета AvalonEdit.
    -->
    <SolidColorBrush x:Key="MarkupTagBrush" Color="#8AB4D6" />
    <SolidColorBrush x:Key="MarkupAttributeNameBrush" Color="#C9A26D" />
    <SolidColorBrush x:Key="MarkupAttributeValueBrush" Color="#8FBF9F" />
    <SolidColorBrush x:Key="MarkupMetaBrush" Color="#8A8A8A" />
</ResourceDictionary>





