<UserControl
    x:Class="AddinManager.Launcher.Views.EntriesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:AddinManager.Launcher.Behaviors"
    xmlns:controls="clr-namespace:AddinManager.Launcher.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:design="clr-namespace:AddinManager.Launcher.Design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:AddinManager.Launcher.ViewModels"
    d:DataContext="{d:DesignInstance Type=design:DesignEntriesViewModel,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="680"
    d:DesignWidth="370"
    TextElement.Foreground="{DynamicResource AppForegroundBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>

        <!--  Локальная копия стиля поиска (см. ListView.xaml).  -->


        <!--  Без родного хрома ListBoxItem — выбор/ховер рисует Border строки.  -->

        <!--  Локальная копия (см. ListView.xaml, там же история откатов).  -->


        <!--  Карточка тултипа иконки предупреждения — тот же желтый стиль, что у баннеров.  -->





        <DataTemplate x:Key="EntryRowTemplate" DataType="{x:Type viewmodels:AddinEntryRowViewModel}">
            <!--  Три строки в строке, остальное — в тултипе: нужно редко, место — часто.  -->
            <Border
                Margin="4,2"
                Padding="10,8"
                d:DataContext="{d:DesignInstance Type=design:DesignEntryRow,
                                                 IsDesignTimeCreatable=True}"
                CornerRadius="10"
                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem Command="{Binding CopyAddInIdsCommand}" Header="{Binding CopyAddInIdMenuLabel}" />
                        <MenuItem Command="{Binding CopyFullClassNamesCommand}" Header="{Binding CopyFullClassNameMenuLabel}" />
                        <Separator />
                        <MenuItem Command="{Binding DeleteSelectedCommand}" Header="{Binding DeleteSelectedLabel}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.ToolTip>
                    <ToolTip Style="{StaticResource CardToolTipStyle}">
                        <StackPanel MaxWidth="320">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="{Binding DisplayName}"
                                TextWrapping="Wrap" />

                            <Border
                                Height="1"
                                Margin="0,8,0,8"
                                Background="{DynamicResource CaptionHoverBrush}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Style="{StaticResource TooltipFieldLabelStyle}"
                                    Text="{Binding TypeLabel}" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Style="{StaticResource TooltipFieldValueStyle}"
                                    Text="{Binding Type}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Style="{StaticResource TooltipFieldLabelStyle}"
                                    Text="AddInId" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Style="{StaticResource TooltipFieldValueStyle}"
                                    Text="{Binding AddInIdText}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource TooltipFieldLabelStyle}"
                                    Text="{Binding AssemblyLabel}" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Style="{StaticResource TooltipFieldValueStyle}"
                                    Text="{Binding Entry.AssemblyPath}" />

                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Style="{StaticResource TooltipFieldLabelStyle}"
                                    Text="{Binding ClassLabel}" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Style="{StaticResource TooltipFieldValueStyle}"
                                    Text="{Binding Entry.FullClassName}" />

                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Style="{StaticResource TooltipFieldLabelStyle}"
                                    Text="{Binding VendorLabel}"
                                    Visibility="{Binding VendorSubtitle, Converter={StaticResource NullOrEmptyToVisibility}}" />
                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Style="{StaticResource TooltipFieldValueStyle}"
                                    Text="{Binding VendorSubtitle}"
                                    Visibility="{Binding VendorSubtitle, Converter={StaticResource NullOrEmptyToVisibility}}" />

                                <TextBlock
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Style="{StaticResource TooltipFieldLabelStyle}"
                                    Text="{Binding DescriptionLabel}"
                                    Visibility="{Binding Entry.Description, Converter={StaticResource NullOrEmptyToVisibility}}" />
                                <TextBlock
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    Style="{StaticResource TooltipFieldValueStyle}"
                                    Text="{Binding Entry.Description}"
                                    Visibility="{Binding Entry.Description, Converter={StaticResource NullOrEmptyToVisibility}}" />

                                <TextBlock
                                    Grid.Row="6"
                                    Grid.Column="0"
                                    Style="{StaticResource TooltipFieldLabelStyle}"
                                    Text="VisibilityMode"
                                    Visibility="{Binding VisibilityModesText, Converter={StaticResource NullOrEmptyToVisibility}}" />
                                <TextBlock
                                    Grid.Row="6"
                                    Grid.Column="1"
                                    Style="{StaticResource TooltipFieldValueStyle}"
                                    Text="{Binding VisibilityModesText}"
                                    Visibility="{Binding VisibilityModesText, Converter={StaticResource NullOrEmptyToVisibility}}" />

                                <TextBlock
                                    Grid.Row="7"
                                    Grid.Column="0"
                                    Style="{StaticResource TooltipFieldLabelStyle}"
                                    Text="Discipline"
                                    Visibility="{Binding DisciplinesText, Converter={StaticResource NullOrEmptyToVisibility}}" />
                                <TextBlock
                                    Grid.Row="7"
                                    Grid.Column="1"
                                    Style="{StaticResource TooltipFieldValueStyle}"
                                    Text="{Binding DisciplinesText}"
                                    Visibility="{Binding DisciplinesText, Converter={StaticResource NullOrEmptyToVisibility}}" />
                            </Grid>
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CaptionHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CaptionHoverBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <CheckBox
                            Margin="0,2,10,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            Style="{StaticResource SelectionCheckBoxRevealStyle}" />

                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="{Binding DisplayName}"
                                    TextTrimming="CharacterEllipsis" />
                                <controls:PackIcon
                                    Width="12"
                                    Height="12"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Focusable="False"
                                    Kind="Warning"
                                    Visibility="{Binding WarningMessage, Converter={StaticResource NullOrEmptyToVisibility}}">
                                    <controls:PackIcon.ToolTip>
                                        <ToolTip Style="{StaticResource WarningCardToolTipStyle}">
                                            <StackPanel MaxWidth="260">
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource WarningTitleBrush}"
                                                    Text="{Binding WarningTooltipTitle}"
                                                    TextWrapping="Wrap" />
                                                <Border
                                                    Height="1"
                                                    Margin="0,6,0,6"
                                                    Background="{DynamicResource WarningBorderBrush}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{DynamicResource AppForegroundBrush}"
                                                    Text="{Binding WarningMessage}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </ToolTip>
                                    </controls:PackIcon.ToolTip>
                                </controls:PackIcon>
                            </StackPanel>
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="11"
                                Opacity="0.55"
                                Text="{Binding Type}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="11"
                                Opacity="0.5"
                                Text="{Binding VendorSubtitle}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding VendorSubtitle, Converter={StaticResource NullOrEmptyToVisibility}}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Команда и тултип — у модели подпанели (см. EntriesViewModel.DeleteEntry).  -->
                    <Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Top"
                        Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource LayoutIconButton}"
                        ToolTip="{Binding DataContext.DeleteEntryTooltip, RelativeSource={RelativeSource AncestorType=ListBox}}">
                        <controls:PackIcon Kind="Close" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="11"
            Opacity="0.5"
            Text="{Binding EmptySelectionPrompt}"
            Visibility="{Binding SelectedFile, Converter={StaticResource HasSelection}, ConverterParameter=Invert}" />

        <DockPanel LastChildFill="True" Visibility="{Binding SelectedFile, Converter={StaticResource HasSelection}}">
            <!--  Ошибки самой панели записей (добавление/удаление) — локальный баннер, не общий заголовок.  -->
            <Border
                Margin="12,0,12,8"
                DockPanel.Dock="Top"
                Style="{StaticResource WarningCardStyle}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}">
                <TextBlock
                    FontSize="11"
                    Text="{Binding ErrorMessage}"
                    TextWrapping="Wrap" />
            </Border>

            <!--  Поиск + добавить запись (иконка; тип спрашивает диалог).  -->
            <Grid Margin="0,0,0,8" DockPanel.Dock="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox Style="{StaticResource SearchBoxStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        IsHitTestVisible="False"
                        Opacity="0.4"
                        Text="{Binding SearchPlaceholder}"
                        Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibility}}" />
                </Grid>
                <Button
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Command="{Binding AddEntryCommand}"
                    Style="{StaticResource LayoutIconButton}"
                    ToolTip="{Binding AddEntryTooltip}">
                    <controls:PackIcon Kind="Add" />
                </Button>
            </Grid>

            <!--  Bulk-панель: записи без тоглов (план, раздел 2), массово только удаляем.  -->
            <Border
                Margin="0,0,0,8"
                Padding="10,8"
                Background="{DynamicResource CaptionHoverBrush}"
                CornerRadius="8"
                DockPanel.Dock="Bottom"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <!--  WrapPanel: на узкой панели команды уходят второй строкой, а не обрезаются.  -->
                <WrapPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="{Binding SelectionSummary}" />
                    <Button
                        Command="{Binding ToggleSelectAllCommand}"
                        Content="{Binding SelectAllToggleLabel}"
                        Style="{StaticResource EditorButtonStyle}" />
                    <Button
                        Command="{Binding DeleteSelectedCommand}"
                        Content="{Binding DeleteSelectedLabel}"
                        Style="{StaticResource EditorButtonStyle}" />
                </WrapPanel>
            </Border>

            <ListBox
                Padding="0,0,12,0"
                behaviors:RightClickSelectionBehavior.Enabled="True"
                Background="Transparent"
                BorderThickness="0"
                ItemTemplate="{StaticResource EntryRowTemplate}"
                ItemsSource="{Binding EntriesView}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                SelectionMode="Extended">
                <ListBox.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Command="{Binding AddEntryCommand}" Header="{Binding AddEntryMenuLabel}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <!--  Контекстные хоткеи записей: тот же приём, что у списка (см. ListView).  -->
                <ListBox.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
                    <KeyBinding
                        Key="A"
                        Command="{Binding ToggleSelectAllCommand}"
                        Modifiers="Control" />
                </ListBox.InputBindings>
                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource RowContainerStyle}" TargetType="ListBoxItem">
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>









