<UserControl
    x:Class="AddinManager.Launcher.Views.ManifestSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:AddinManager.Launcher.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:design="clr-namespace:AddinManager.Launcher.Design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:AddinManager.Launcher.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=design:DesignSettingsViewModel, IsDesignTimeCreatable=True}"
    d:DesignWidth="370" d:DesignHeight="680"
    TextElement.Foreground="{DynamicResource AppForegroundBrush}">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="HasSelection" />
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />
        <converters:NullableBoolStateToOpacityConverter x:Key="UseRevitContextOpacity" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Локальные копии из FormView.xaml (стили не выносятся из вида). -->
        <Style x:Key="EditorButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CaptionHoverBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChipButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CaptionHoverBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Revit запущен: чипс гаснет (плюс CanExecute команды). -->
                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        

        

        
    </UserControl.Resources>

    <Grid>
        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="11"
            Opacity="0.5"
            Text="{Binding EmptySelectionPrompt}"
            Visibility="{Binding SelectedFile, Converter={StaticResource HasSelection}, ConverterParameter=Invert}" />

        <DockPanel LastChildFill="True" Visibility="{Binding SelectedFile, Converter={StaticResource HasSelection}}">
            <!-- Высота и левый край заголовка — как у соседних подпанелей (см. architecture.md, Themes). -->
            <StackPanel Margin="12,12,12,10" DockPanel.Dock="Top">
                <Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="{Binding SelectedFile.FileName}"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            Command="{Binding DiscardCommand}"
                            Content="{Binding DiscardButtonLabel}"
                            Style="{StaticResource EditorButtonStyle}" />
                        <Button
                            Command="{Binding SaveCommand}"
                            Content="{Binding SaveButtonLabel}"
                            Style="{StaticResource EditorButtonStyle}" />
                    </StackPanel>
                </Grid>

                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="11"
                    Opacity="0.5"
                    Text="{Binding SelectedFile.MetaLine}" />

                <Border
                    Margin="0,8,0,0"
                    Padding="10,6"
                    Background="{DynamicResource WarningBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}">
                    <TextBlock
                        FontSize="11"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <!-- Без карточки (как форма); 26 справа = 16 + 10 скроллбара (см. architecture.md, Themes). -->
            <Border Background="Transparent">
                <ScrollViewer Padding="16,16,26,16" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="11"
                            Opacity="0.6"
                            Text="{Binding UnsupportedNotice}"
                            TextWrapping="Wrap"
                            Visibility="{Binding IsSupported, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

                        <StackPanel Visibility="{Binding IsSupported, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Style="{StaticResource FieldGroupStyle}">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="UseRevitContext" />
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Command="{Binding SetUseRevitContextCommand}"
                                        CommandParameter="Unset"
                                        Content="{Binding UnsetOptionLabel}"
                                        Opacity="{Binding UseRevitContext, Converter={StaticResource UseRevitContextOpacity}, ConverterParameter=Unset}"
                                        Style="{StaticResource ChipButtonStyle}" />
                                    <Button
                                        Command="{Binding SetUseRevitContextCommand}"
                                        CommandParameter="True"
                                        Content="{Binding YesOptionLabel}"
                                        Opacity="{Binding UseRevitContext, Converter={StaticResource UseRevitContextOpacity}, ConverterParameter=True}"
                                        Style="{StaticResource ChipButtonStyle}" />
                                    <Button
                                        Command="{Binding SetUseRevitContextCommand}"
                                        CommandParameter="False"
                                        Content="{Binding NoOptionLabel}"
                                        Opacity="{Binding UseRevitContext, Converter={StaticResource UseRevitContextOpacity}, ConverterParameter=False}"
                                        Style="{StaticResource ChipButtonStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Style="{StaticResource FieldGroupStyle}">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="ContextName" />
                                <TextBox Style="{StaticResource FieldTextBoxStyle}" Text="{Binding ContextName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>

