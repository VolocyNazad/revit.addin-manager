<UserControl
    x:Class="AddinManager.Launcher.Views.EditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:composition="clr-namespace:AddinManager.Launcher.Composition"
    xmlns:controls="clr-namespace:AddinManager.Launcher.Controls"
    xmlns:converters="clr-namespace:AddinManager.Launcher.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:design="clr-namespace:AddinManager.Launcher.Design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:AddinManager.Launcher.ViewModels"
    d:DataContext="{d:DesignInstance Type=design:DesignEditorViewModel,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="680"
    d:DesignWidth="750"
    TextElement.Foreground="{DynamicResource AppForegroundBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:EnumEqualsToOpacityConverter x:Key="ActiveModeOpacityConverter" />
        <converters:EditorModeToVisibilityConverter x:Key="EditorModeVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="HasSelectedFile" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Grid>
        <Border
            x:Name="EditorAccent"
            Background="{DynamicResource EditorAccentBrush}"
            CornerRadius="30 0 0 0" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel
                Grid.Row="0"
                Margin="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Command="{Binding SetEditorModeCommand}"
                    CommandParameter="{x:Static viewmodels:EditorMode.Entries}"
                    Opacity="{Binding Mode, Converter={StaticResource ActiveModeOpacityConverter}, ConverterParameter={x:Static viewmodels:EditorMode.Entries}}"
                    Style="{StaticResource LayoutIconButton}"
                    ToolTip="{Binding EntriesTooltip}">
                    <controls:PackIcon
                        Width="{StaticResource IconSize}"
                        Height="{StaticResource IconSize}"
                        Focusable="False"
                        Kind="List" />
                </Button>
                <Button
                    Margin="2,0,0,0"
                    Command="{Binding SetEditorModeCommand}"
                    CommandParameter="{x:Static viewmodels:EditorMode.Form}"
                    Opacity="{Binding Mode, Converter={StaticResource ActiveModeOpacityConverter}, ConverterParameter={x:Static viewmodels:EditorMode.Form}}"
                    Style="{StaticResource LayoutIconButton}"
                    ToolTip="{Binding FormTooltip}">
                    <controls:PackIcon
                        Width="{StaticResource IconSize}"
                        Height="{StaticResource IconSize}"
                        Focusable="False"
                        Kind="Form" />
                </Button>
                <Button
                    Margin="2,0,0,0"
                    Command="{Binding SetEditorModeCommand}"
                    CommandParameter="{x:Static viewmodels:EditorMode.Markup}"
                    Opacity="{Binding Mode, Converter={StaticResource ActiveModeOpacityConverter}, ConverterParameter={x:Static viewmodels:EditorMode.Markup}}"
                    Style="{StaticResource LayoutIconButton}"
                    ToolTip="{Binding MarkupTooltip}">
                    <controls:PackIcon
                        Width="{StaticResource IconSize}"
                        Height="{StaticResource IconSize}"
                        Focusable="False"
                        Kind="Markup" />
                </Button>
                <Button
                    Margin="8,0,0,0"
                    Command="{Binding SetEditorModeCommand}"
                    CommandParameter="{x:Static viewmodels:EditorMode.EntriesForm}"
                    Opacity="{Binding Mode, Converter={StaticResource ActiveModeOpacityConverter}, ConverterParameter={x:Static viewmodels:EditorMode.EntriesForm}}"
                    Style="{StaticResource LayoutIconButton}"
                    ToolTip="{Binding EntriesFormTooltip}">
                    <controls:PackIcon
                        Width="{StaticResource IconSize}"
                        Height="{StaticResource IconSize}"
                        Focusable="False"
                        Kind="EntriesForm" />
                </Button>
                <Button
                    Margin="2,0,0,0"
                    Command="{Binding SetEditorModeCommand}"
                    CommandParameter="{x:Static viewmodels:EditorMode.EntriesMarkup}"
                    Opacity="{Binding Mode, Converter={StaticResource ActiveModeOpacityConverter}, ConverterParameter={x:Static viewmodels:EditorMode.EntriesMarkup}}"
                    Style="{StaticResource LayoutIconButton}"
                    ToolTip="{Binding EntriesMarkupTooltip}">
                    <controls:PackIcon
                        Width="{StaticResource IconSize}"
                        Height="{StaticResource IconSize}"
                        Focusable="False"
                        Kind="EntriesMarkup" />
                </Button>
                <Button
                    Margin="8,0,0,0"
                    Command="{Binding SetEditorModeCommand}"
                    CommandParameter="{x:Static viewmodels:EditorMode.Settings}"
                    Opacity="{Binding Mode, Converter={StaticResource ActiveModeOpacityConverter}, ConverterParameter={x:Static viewmodels:EditorMode.Settings}}"
                    Style="{StaticResource LayoutIconButton}"
                    ToolTip="{Binding SettingsTooltip}">
                    <controls:PackIcon
                        Width="{StaticResource IconSize}"
                        Height="{StaticResource IconSize}"
                        Focusable="False"
                        Kind="Settings" />
                </Button>
            </StackPanel>
            <Grid Grid.Row="1" Margin="8,0,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                    Общий заголовок всех режимов: имя файла, мета-строка, бейдж несохранённых
                    правок, кнопки Save/Discard активной панели и её ошибка. В комбинированных
                    режимах подпанели заголовков не повторяют — см. docs/architecture.md, "Editor".
                -->
                <StackPanel
                    Grid.Row="0"
                    Margin="12,12,12,10"
                    Visibility="{Binding SelectedFile, Converter={StaticResource HasSelectedFile}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="{Binding SelectedFile.FileName}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Opacity="0.55"
                            Text="{Binding UnsavedBadge}"
                            Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Visibility="{Binding ShowHeaderActions, Converter={StaticResource BoolToVisibility}}">
                            <Button
                                Command="{Binding DiscardActiveCommand}"
                                Content="{Binding DiscardLabel}"
                                Style="{StaticResource EditorButtonStyle}" />
                            <Button
                                Command="{Binding SaveActiveCommand}"
                                Content="{Binding SaveLabel}"
                                Style="{StaticResource EditorButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="11"
                        Opacity="0.5"
                        Text="{Binding SelectedFile.MetaLine}" />

                    <Border
                        Margin="0,8,0,0"
                        Padding="10,6"
                        Background="{DynamicResource WarningBackgroundBrush}"
                        BorderBrush="{DynamicResource WarningBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding HasHeaderError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            FontSize="11"
                            Text="{Binding HeaderError}"
                            TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="EditorEntriesColumn" Width="*" />
                        <ColumnDefinition x:Name="EditorComboSplitterColumn" Width="0" />
                        <ColumnDefinition x:Name="EditorDetailColumn" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="EntriesPanel" Grid.Column="0">
                        <ContentControl Content="{composition:ViewModelLocator {x:Type viewmodels:EntriesViewModel}}" />
                    </Grid>
                    <GridSplitter
                        x:Name="EditorComboSplitter"
                        Grid.Column="1"
                        Width="9"
                        Margin="0,4,0,4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"
                        DragCompleted="OnEditorSplitterDragCompleted">
                        <GridSplitter.Template>
                            <ControlTemplate TargetType="GridSplitter">
                                <Border Background="Transparent">
                                    <Border
                                        Width="1"
                                        Margin="0,4,0,4"
                                        HorizontalAlignment="Center"
                                        Background="Gray"
                                        Opacity="0.5" />
                                </Border>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>
                    <Grid x:Name="DetailPanel" Grid.Column="2">
                        <ContentControl Content="{composition:ViewModelLocator {x:Type viewmodels:FormViewModel}}" Visibility="{Binding Mode, Converter={StaticResource EditorModeVisibilityConverter}, ConverterParameter='Form,EntriesForm'}" />
                        <ContentControl Content="{composition:ViewModelLocator {x:Type viewmodels:MarkupViewModel}}" Visibility="{Binding Mode, Converter={StaticResource EditorModeVisibilityConverter}, ConverterParameter='Markup,EntriesMarkup'}" />
                        <ContentControl Content="{composition:ViewModelLocator {x:Type viewmodels:ManifestSettingsViewModel}}" Visibility="{Binding Mode, Converter={StaticResource EditorModeVisibilityConverter}, ConverterParameter='Settings'}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

