<Window x:Class="AddinManager.Launcher.Views.Dialogs.UpdateDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:AddinManager.Launcher.Behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:design="clr-namespace:AddinManager.Launcher.Design"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=design:DesignUpdateDialogViewModel,
                                       IsDesignTimeCreatable=True}"
        d:DesignHeight="320"
        d:DesignWidth="520"
        mc:Ignorable="d"
        Title=""
        MinWidth="360"
        MaxWidth="520"
        Style="{StaticResource DialogWindowStyle}"
        WindowStartupLocation="CenterScreen">
    <i:Interaction.Behaviors>
        <behaviors:DialogResultBehavior DialogResult="{Binding Result}" />
    </i:Interaction.Behaviors>
    <Border Style="{StaticResource DialogCardStyle}">
        <i:Interaction.Behaviors>
            <behaviors:WindowDragBehavior />
        </i:Interaction.Behaviors>
        <StackPanel>
            <TextBlock FontSize="13"
                       FontWeight="SemiBold"
                       Text="{Binding TitleLabel}" />
            <TextBlock Margin="0,6,0,0"
                       FontSize="12"
                       Text="{Binding Message}"
                       TextWrapping="Wrap" />
            <StackPanel Margin="0,12,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Command="{Binding LaterCommand}"
                        Content="{Binding LaterLabel}"
                        IsCancel="True"
                        Style="{StaticResource EditorButtonStyle}" />
                <Button Margin="4,0,0,0"
                        Command="{Binding DownloadCommand}"
                        Content="{Binding DownloadLabel}"
                        IsDefault="True"
                        Style="{StaticResource EditorButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

