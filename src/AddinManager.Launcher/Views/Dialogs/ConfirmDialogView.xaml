<Window x:Class="AddinManager.Launcher.Views.Dialogs.ConfirmDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:AddinManager.Launcher.Behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:design="clr-namespace:AddinManager.Launcher.Design"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=design:DesignConfirmDialogViewModel,
                                       IsDesignTimeCreatable=True}"
        d:DesignHeight="420"
        d:DesignWidth="520"
        mc:Ignorable="d"
        Title=""
        MinWidth="320"
        MaxWidth="520"
        Style="{StaticResource DialogWindowStyle}"
        WindowStartupLocation="CenterScreen">
    <i:Interaction.Behaviors>
        <behaviors:DialogResultBehavior DialogResult="{Binding Result}" />
    </i:Interaction.Behaviors>
    <Border Style="{StaticResource DialogCardStyle}">
        <i:Interaction.Behaviors>
            <behaviors:WindowDragBehavior />
        </i:Interaction.Behaviors>
        <StackPanel>
            <TextBlock FontSize="12"
                       Text="{Binding Message}"
                       TextWrapping="Wrap" />
            <StackPanel Margin="0,10,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Command="{Binding NoCommand}"
                        Content="{Binding NoLabel}"
                        IsCancel="True"
                        Style="{StaticResource EditorButtonStyle}" />
                <Button Margin="4,0,0,0"
                        Command="{Binding YesCommand}"
                        Content="{Binding YesLabel}"
                        IsDefault="True"
                        Style="{StaticResource EditorButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

