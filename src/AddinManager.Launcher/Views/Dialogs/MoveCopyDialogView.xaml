<Window
    x:Class="AddinManager.Launcher.Views.Dialogs.MoveCopyDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:AddinManager.Launcher.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:design="clr-namespace:AddinManager.Launcher.Design"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:storage="clr-namespace:AddinManager.Core.Storage;assembly=AddinManager.Core"
    Title=""
    MinWidth="420"
    MaxWidth="620"
    d:DataContext="{d:DesignInstance Type=design:DesignMoveCopyDialogViewModel,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="620"
    d:DesignWidth="620"
    Style="{StaticResource DialogWindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <i:Interaction.Behaviors>
        <behaviors:DialogResultBehavior DialogResult="{Binding Result}" />
    </i:Interaction.Behaviors>
    <Border Style="{StaticResource DialogCardStyle}">
        <i:Interaction.Behaviors>
            <behaviors:WindowDragBehavior />
        </i:Interaction.Behaviors>
        <StackPanel>
            <TextBlock
                Margin="0,0,0,10"
                FontSize="15"
                FontWeight="SemiBold"
                Text="{Binding Title}" />

            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding SourceLabel}" />
            <TextBlock
                Margin="0,0,0,8"
                FontSize="12"
                Opacity="0.75"
                Text="{Binding FileName}"
                TextWrapping="Wrap" />

            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding VersionLabel}" />
            <ItemsControl ItemsSource="{Binding VersionChips}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Margin="0,0,0,8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Command="{Binding DataContext.SetVersionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Value}"
                            Content="{Binding Label}"
                            Style="{StaticResource VersionChipButtonStyle}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding ScopeLabel}" />
            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                <Button
                    Command="{Binding SetScopeCommand}"
                    CommandParameter="{x:Static storage:AddinScope.User}"
                    Content="User"
                    Opacity="{Binding Scope, Converter={StaticResource ActiveOpacity}, ConverterParameter={x:Static storage:AddinScope.User}}"
                    Style="{StaticResource ChipButtonStyle}" />
                <Button
                    Command="{Binding SetScopeCommand}"
                    CommandParameter="{x:Static storage:AddinScope.Machine}"
                    Content="Machine"
                    Opacity="{Binding Scope, Converter={StaticResource ActiveOpacity}, ConverterParameter={x:Static storage:AddinScope.Machine}}"
                    Style="{StaticResource ChipButtonStyle}" />
            </StackPanel>

            <ToggleButton
                Content="{Binding EnableAfterLabel}"
                IsChecked="{Binding EnableAfter, Mode=TwoWay}"
                Style="{StaticResource ChipToggleStyle}" />

            <TextBlock
                Margin="0,10,0,2"
                Style="{StaticResource FieldLabelStyle}"
                Text="{Binding TargetLabel}" />
            <TextBlock
                FontSize="11"
                Opacity="0.7"
                Text="{Binding TargetPath}"
                TextWrapping="Wrap" />

            <Border
                Margin="0,8,0,0"
                Style="{StaticResource WarningCardStyle}"
                Visibility="{Binding SameFolderError, Converter={StaticResource NullOrEmptyToVisibility}}">
                <TextBlock
                    FontSize="11"
                    Text="{Binding SameFolderError}"
                    TextWrapping="Wrap" />
            </Border>

            <Border
                Margin="0,8,0,0"
                Style="{StaticResource WarningCardStyle}"
                Visibility="{Binding ConflictWarning, Converter={StaticResource NullOrEmptyToVisibility}}">
                <StackPanel>
                    <TextBlock
                        FontSize="11"
                        Text="{Binding ConflictWarning}"
                        TextWrapping="Wrap" />
                    <CheckBox
                        Margin="0,6,0,0"
                        Content="{Binding OverwriteLabel}"
                        IsChecked="{Binding Overwrite, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border
                Margin="0,8,0,0"
                Style="{StaticResource WarningCardStyle}"
                Visibility="{Binding CrossVersionWarning, Converter={StaticResource NullOrEmptyToVisibility}}">
                <TextBlock
                    FontSize="11"
                    Text="{Binding CrossVersionWarning}"
                    TextWrapping="Wrap" />
            </Border>

            <Border
                Margin="0,8,0,0"
                Style="{StaticResource WarningCardStyle}"
                Visibility="{Binding SettingsWarning, Converter={StaticResource NullOrEmptyToVisibility}}">
                <TextBlock
                    FontSize="11"
                    Text="{Binding SettingsWarning}"
                    TextWrapping="Wrap" />
            </Border>

            <Border
                Margin="0,8,0,0"
                Style="{StaticResource WarningCardStyle}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}">
                <TextBlock
                    FontSize="11"
                    Text="{Binding ErrorMessage}"
                    TextWrapping="Wrap" />
            </Border>

            <StackPanel
                Margin="0,10,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Command="{Binding CancelCommand}"
                    Content="{Binding CancelButtonLabel}"
                    IsCancel="True"
                    Style="{StaticResource EditorButtonStyle}" />
                <Button
                    Margin="4,0,0,0"
                    Command="{Binding ConfirmCommand}"
                    Content="{Binding ConfirmButtonLabel}"
                    IsDefault="True"
                    Style="{StaticResource EditorButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
