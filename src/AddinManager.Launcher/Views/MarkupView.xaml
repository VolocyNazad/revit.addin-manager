<UserControl
    x:Class="AddinManager.Launcher.Views.MarkupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:behaviors="clr-namespace:AddinManager.Launcher.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:design="clr-namespace:AddinManager.Launcher.Design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    behaviors:AvalonEditSearchBehavior.Search="{Binding Search}"
    d:DataContext="{d:DesignInstance Type=design:DesignMarkupViewModel,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="680"
    d:DesignWidth="370"
    TextElement.Foreground="{DynamicResource AppForegroundBrush}"
    mc:Ignorable="d">
    <!--  Отмена правок разметки: тот же скоуп, что у формы (см. FormView).  -->
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding DiscardCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="11"
            Opacity="0.5"
            Text="{Binding EmptySelectionPrompt}"
            Visibility="{Binding SelectedFile, Converter={StaticResource HasSelection}, ConverterParameter=Invert}" />

        <DockPanel LastChildFill="True" Visibility="{Binding SelectedFile, Converter={StaticResource HasSelection}}">
            <!--
                Постоянная строка поиска над редактором, одной строкой как в Revit Linter Editor:
                она занимает собственную строку и никогда не перекрывает код. Поле тянется,
                справа — счётчик, параметры и навигация; на очень узкой панели приоритет у поля.
            -->
            <Grid Margin="10,0,10,6" DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,4,0">
                    <TextBox
                        x:Name="SearchQueryBox"
                        Style="{StaticResource SearchBoxStyle}"
                        Text="{Binding Search.Query, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding Search.NextCommand}" />
                            <KeyBinding
                                Key="Enter"
                                Command="{Binding Search.PreviousCommand}"
                                Modifiers="Shift" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        IsHitTestVisible="False"
                        Opacity="0.4"
                        Text="{Binding Search.Placeholder}"
                        Visibility="{Binding Search.IsQueryEmpty, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <TextBlock
                    Grid.Column="1"
                    MinWidth="46"
                    Margin="4,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Opacity="0.55"
                    Text="{Binding Search.StatusText}"
                    Visibility="{Binding Search.HasStatus, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel
                    Grid.Column="2"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ToggleButton
                        Content="Aa"
                        IsChecked="{Binding Search.MatchCase}"
                        Style="{StaticResource ChipToggleStyle}"
                        ToolTip="{Binding Search.MatchCaseTooltip}" />
                    <ToggleButton
                        Content="ab"
                        IsChecked="{Binding Search.WholeWords}"
                        Style="{StaticResource ChipToggleStyle}"
                        ToolTip="{Binding Search.WholeWordsTooltip}" />
                    <ToggleButton
                        Content=".*"
                        IsChecked="{Binding Search.UseRegex}"
                        Style="{StaticResource ChipToggleStyle}"
                        ToolTip="{Binding Search.UseRegexTooltip}" />
                    <Button
                        Margin="4,0,0,0"
                        Command="{Binding Search.PreviousCommand}"
                        Content="↑"
                        Style="{StaticResource LayoutIconButton}"
                        ToolTip="{Binding Search.PreviousTooltip}" />
                    <Button
                        Command="{Binding Search.NextCommand}"
                        Content="↓"
                        Style="{StaticResource LayoutIconButton}"
                        ToolTip="{Binding Search.NextTooltip}" />
                </StackPanel>
            </Grid>

            <!--
                TextEditor.Padding (22 = 12 + 10 скроллбара) уходит во внутренний ScrollViewer
                AvalonEdit и держит текст от нахлёста; Padding внешнего Border — только зазор
                до скругления. Механизм — см. architecture.md, Themes.
            -->
            <Border
                Margin="10"
                Padding="8,4"
                Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource CaptionHoverBrush}"
                BorderThickness="1"
                ClipToBounds="True"
                CornerRadius="15">
                <avalonedit:TextEditor
                    x:Name="Editor"
                    Padding="12,12,22,22"
                    behaviors:AvalonEditMarkupBehavior.DiagnosticSpans="{Binding DiagnosticSpans}"
                    behaviors:AvalonEditMarkupBehavior.SelectedEntrySpan="{Binding SelectedEntrySpan}"
                    behaviors:AvalonEditMarkupBehavior.Text="{Binding RawXml, Mode=TwoWay}"
                    Background="{DynamicResource AppBackgroundBrush}"
                    FontFamily="{DynamicResource MonoFontFamily}"
                    FontSize="10"
                    Foreground="{DynamicResource AppForegroundBrush}"
                    IsReadOnly="{Binding IsLocked}"
                    LineNumbersForeground="{DynamicResource AppForegroundBrush}"
                    ShowLineNumbers="True"
                    WordWrap="False" />
            </Border>
        </DockPanel>
    </Grid>
</UserControl>

