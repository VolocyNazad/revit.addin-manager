<UserControl
    x:Class="AddinManager.Launcher.Views.MarkupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:converters="clr-namespace:AddinManager.Launcher.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:design="clr-namespace:AddinManager.Launcher.Design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=design:DesignMarkupViewModel, IsDesignTimeCreatable=True}"
    d:DesignWidth="370" d:DesignHeight="680"
    TextElement.Foreground="{DynamicResource AppForegroundBrush}">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="HasSelection" />
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="EditorButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CaptionHoverBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="11"
            Opacity="0.5"
            Text="{Binding EmptySelectionPrompt}"
            Visibility="{Binding SelectedFile, Converter={StaticResource HasSelection}, ConverterParameter=Invert}" />

        <DockPanel LastChildFill="True" Visibility="{Binding SelectedFile, Converter={StaticResource HasSelection}}">
            <!-- Высота и левый край заголовка — как у соседней подпанели (см. architecture.md, Themes). -->
            <StackPanel Margin="12,12,12,10" DockPanel.Dock="Top">
                <!-- Строку не ужимать: высоту задают кнопки (см. скрытую пару в EntriesView). -->
                <Grid>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="{Binding SelectedFile.FileName}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Opacity="0.55"
                            Text="{Binding UnsavedBadge}"
                            Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            Command="{Binding DiscardCommand}"
                            Content="{Binding DiscardButtonLabel}"
                            Style="{StaticResource EditorButtonStyle}" />
                        <Button
                            Command="{Binding SaveCommand}"
                            Content="{Binding SaveButtonLabel}"
                            Style="{StaticResource EditorButtonStyle}" />
                    </StackPanel>
                </Grid>

                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="11"
                    Opacity="0.5"
                    Text="{Binding SelectedFile.MetaLine}" />

                <Border
                    Margin="0,8,0,0"
                    Padding="10,6"
                    Background="{DynamicResource WarningBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}">
                    <TextBlock
                        FontSize="11"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <!--
                TextEditor.Padding (22 = 12 + 10 скроллбара) уходит во внутренний ScrollViewer
                AvalonEdit и держит текст от нахлёста; Padding внешнего Border — только зазор
                до скругления. Механизм — см. architecture.md, Themes.
            -->
            <Border
                Padding="8 4" Margin="10"
                Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource CaptionHoverBrush}"
                BorderThickness="1"
                ClipToBounds="True"
                CornerRadius="15">
                <avalonedit:TextEditor
                    x:Name="Editor"
                    Padding="12,12,22,22"
                    Background="{DynamicResource AppBackgroundBrush}"
                    FontFamily="Cascadia Code, Consolas, monospace"
                    FontSize="10"
                    Foreground="{DynamicResource AppForegroundBrush}"
                    IsReadOnly="{Binding IsLocked}"
                    LineNumbersForeground="{DynamicResource AppForegroundBrush}"
                    ShowLineNumbers="True"
                    WordWrap="False" />
            </Border>
        </DockPanel>
    </Grid>
</UserControl>

