<UserControl
    x:Class="AddinManager.Launcher.Views.ListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:AddinManager.Launcher.Behaviors"
    xmlns:controls="clr-namespace:AddinManager.Launcher.Controls"
    xmlns:converters="clr-namespace:AddinManager.Launcher.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:design="clr-namespace:AddinManager.Launcher.Design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:AddinManager.Launcher.ViewModels"
    d:DataContext="{d:DesignInstance Type=design:DesignListViewModel,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="680"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />
        <converters:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:EnumEqualsToOpacityConverter x:Key="ActiveOpacity" />

        <!--
            Карточка вместо системного ToolTip (тот же вид, что подпанели редактора).
            Контрастные варианты пробовали — откачены, подробности в docs/architecture.md,
            раздел "Plugin list": не повторять.
        -->

        <!--  Карточка тултипа иконки предупреждения — тот же желтый стиль, что у баннеров.  -->


        <!--  Подписи полей карточки — сплошным приглушённым цветом темы, не полупрозрачностью.  -->

        <DataTemplate x:Key="RowTemplate" DataType="{x:Type viewmodels:AddinFileRowViewModel}">
            <Border
                Margin="4,2"
                Padding="12,10"
                d:DataContext="{d:DesignInstance Type=design:DesignFileRow,
                                                 IsDesignTimeCreatable=True}"
                CornerRadius="10"
                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem
                            Command="{Binding ShowInFolderCommand}"
                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            Header="{Binding ShowInFolderLabel}" />
                        <MenuItem
                            Command="{Binding BeginRenameCommand}"
                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            Header="{Binding RenameMenuLabel}" />
                        <MenuItem
                            Command="{Binding ToggleSelectedCommand}"
                            Header="{Binding ToggleSelectedLabel}" />
                        <Separator />
                        <MenuItem
                            Command="{Binding CopyPathsCommand}"
                            Header="{Binding CopyPathsMenuLabel}" />
                        <MenuItem
                            Command="{Binding CopyFileNamesCommand}"
                            Header="{Binding CopyFileNamesMenuLabel}" />
                        <Separator />
                        <MenuItem
                            Command="{Binding DeleteSelectedCommand}"
                            Header="{Binding DeleteSelectedLabel}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CaptionHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CaptionHoverBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Border.ToolTip>
                    <ToolTip Style="{StaticResource CardToolTipStyle}">
                        <StackPanel MaxWidth="300">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="{Binding FileName}"
                                TextWrapping="Wrap" />

                            <Border
                                Height="1"
                                Margin="0,8,0,8"
                                Background="{DynamicResource CaptionHoverBrush}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Style="{StaticResource TooltipFieldLabelStyle}"
                                    Text="{Binding FilePathLabel}" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Style="{StaticResource TooltipFieldValueStyle}"
                                    Text="{Binding FullPath}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Style="{StaticResource TooltipFieldLabelStyle}"
                                    Text="{Binding FileVersionLabel}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Style="{StaticResource TooltipFieldValueStyle}"
                                    Text="{Binding Version}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource TooltipFieldLabelStyle}"
                                    Text="{Binding FileScopeLabel}" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Style="{StaticResource TooltipFieldValueStyle}"
                                    Text="{Binding Scope}" />

                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Style="{StaticResource TooltipFieldLabelStyle}"
                                    Text="{Binding FileTypeLabel}" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Style="{StaticResource TooltipFieldValueStyle}"
                                    Text="{Binding TypeSummary}" />

                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Style="{StaticResource TooltipFieldLabelStyle}"
                                    Text="{Binding FileVendorLabel}"
                                    Visibility="{Binding VendorSubtitle, Converter={StaticResource NullOrEmptyToVisibility}}" />
                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Style="{StaticResource TooltipFieldValueStyle}"
                                    Text="{Binding VendorSubtitle}"
                                    Visibility="{Binding VendorSubtitle, Converter={StaticResource NullOrEmptyToVisibility}}" />
                            </Grid>

                            <TextBlock
                                Margin="0,8,0,2"
                                FontSize="11"
                                Foreground="{DynamicResource TooltipLabelBrush}"
                                Text="{Binding FileContentsHeader}" />
                            <ItemsControl ItemsSource="{Binding EntrySummaries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="11"
                                            Foreground="{DynamicResource AppForegroundBrush}"
                                            Text="{Binding}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <CheckBox
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            Style="{StaticResource SelectionCheckBoxRevealStyle}" />
                        <CheckBox
                            Margin="0,0,14,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                            Style="{StaticResource ToggleSwitchStyle}" />

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Grid VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{Binding FileName}"
                                        Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                    <TextBox
                                        x:Name="RenameBox"
                                        MinWidth="180"
                                        Padding="6,2"
                                        FontSize="13"
                                        IsVisibleChanged="OnRenameBoxIsVisibleChanged"
                                        KeyDown="OnRenameBoxKeyDown"
                                        LostKeyboardFocus="OnRenameBoxLostFocus"
                                        Style="{StaticResource FieldTextBoxStyle}"
                                        Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                                <controls:PackIcon
                                    Width="12"
                                    Height="12"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Focusable="False"
                                    Kind="Warning"
                                    Visibility="{Binding WarningMessage, Converter={StaticResource NullOrEmptyToVisibility}}">
                                    <controls:PackIcon.ToolTip>
                                        <ToolTip Style="{StaticResource WarningCardToolTipStyle}">
                                            <StackPanel MaxWidth="260">
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource WarningTitleBrush}"
                                                    Text="{Binding WarningTooltipTitle}"
                                                    TextWrapping="Wrap" />
                                                <Border
                                                    Height="1"
                                                    Margin="0,6,0,6"
                                                    Background="{DynamicResource WarningBorderBrush}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{DynamicResource AppForegroundBrush}"
                                                    Text="{Binding WarningMessage}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </ToolTip>
                                    </controls:PackIcon.ToolTip>
                                </controls:PackIcon>
                            </StackPanel>
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="11"
                                Opacity="0.55"
                                Text="{Binding MetaLine}" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="11"
                                Opacity="0.4"
                                Text="{Binding VendorSubtitle}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding VendorSubtitle, Converter={StaticResource NullOrEmptyToVisibility}}" />

                            <!--  Ошибка тоггла конкретной строки (см. AddinFileRowViewModel) — тот же желтый стиль, что у баннеров.  -->
                            <Border
                                Margin="0,4,0,0"
                                Padding="8,5"
                                Background="{DynamicResource WarningBackgroundBrush}"
                                BorderBrush="{DynamicResource WarningBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}">
                                <TextBlock
                                    FontSize="11"
                                    Text="{Binding ErrorMessage}"
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!--  Папка и крестик строки: команды — у строки (удаление) и у списка (папка).  -->
                    <StackPanel
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                        <Button
                            Command="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=DataContext.ShowInFolderCommand}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource LayoutIconButton}"
                            ToolTip="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=DataContext.ShowInFolderLabel}">
                            <controls:PackIcon
                                Width="{StaticResource IconSize}"
                                Height="{StaticResource IconSize}"
                                Focusable="False"
                                Kind="Folder" />
                        </Button>
                        <Button
                            Margin="4,0,0,0"
                            Command="{Binding DeleteCommand}"
                            Style="{StaticResource LayoutIconButton}"
                            ToolTip="{Binding DeleteButtonTooltip}">
                            <controls:PackIcon
                                Width="{StaticResource IconSize}"
                                Height="{StaticResource IconSize}"
                                Focusable="False"
                                Kind="Close" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <!--  F2 переименовывает выбранный файл: скоуп — вся панель, чтобы работать и из поиска/фильтров.  -->
    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding BeginRenameCommand}" />
    </UserControl.InputBindings>

    <DockPanel Margin="8 8 0 8" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox Style="{StaticResource SearchBoxStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        IsHitTestVisible="False"
                        Opacity="0.4"
                        Text="{Binding SearchPlaceholder}"
                        Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibility}}" />
                </Grid>
                <StackPanel
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding AddFileCommand}"
                        Style="{StaticResource LayoutIconButton}"
                        ToolTip="{Binding AddFileTooltip}">
                        <controls:PackIcon
                            Width="{StaticResource IconSize}"
                            Height="{StaticResource IconSize}"
                            Focusable="False"
                            Kind="Add" />
                    </Button>
                    <Button
                        Margin="4,0,0,0"
                        Command="{Binding RefreshManualCommand}"
                        Style="{StaticResource LayoutIconButton}"
                        ToolTip="{Binding RefreshTooltip}">
                        <controls:PackIcon
                            Width="{StaticResource IconSize}"
                            Height="{StaticResource IconSize}"
                            Focusable="False"
                            Kind="Refresh" />
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                <Button
                    Command="{Binding SetScopeFilterCommand}"
                    CommandParameter="{x:Static viewmodels:ScopeFilter.All}"
                    Content="{Binding ScopeAllChipLabel}"
                    Opacity="{Binding ScopeFilter, Converter={StaticResource ActiveOpacity}, ConverterParameter={x:Static viewmodels:ScopeFilter.All}}"
                    Style="{StaticResource ChipButtonStyle}" />
                <Button
                    Command="{Binding SetScopeFilterCommand}"
                    CommandParameter="{x:Static viewmodels:ScopeFilter.User}"
                    Content="{Binding ScopeUserChipLabel}"
                    Opacity="{Binding ScopeFilter, Converter={StaticResource ActiveOpacity}, ConverterParameter={x:Static viewmodels:ScopeFilter.User}}"
                    Style="{StaticResource ChipButtonStyle}" />
                <Button
                    Command="{Binding SetScopeFilterCommand}"
                    CommandParameter="{x:Static viewmodels:ScopeFilter.Machine}"
                    Content="{Binding ScopeMachineChipLabel}"
                    Opacity="{Binding ScopeFilter, Converter={StaticResource ActiveOpacity}, ConverterParameter={x:Static viewmodels:ScopeFilter.Machine}}"
                    Style="{StaticResource ChipButtonStyle}" />
            </StackPanel>

            <WrapPanel Margin="0,0,0,6">
                <Button
                    Command="{Binding SetVersionFilterCommand}"
                    CommandParameter="{x:Null}"
                    Content="{Binding VersionAllChipLabel}"
                    Opacity="{Binding VersionFilter, Converter={StaticResource ActiveOpacity}, ConverterParameter={x:Null}}"
                    Style="{StaticResource VersionChipButtonStyle}" />
                <Button
                    Command="{Binding SetVersionFilterCommand}"
                    CommandParameter="2021"
                    Content="{Binding Version2021ChipLabel}"
                    Opacity="{Binding VersionFilter, Converter={StaticResource ActiveOpacity}, ConverterParameter=2021}"
                    Style="{StaticResource VersionChipButtonStyle}" />
                <Button
                    Command="{Binding SetVersionFilterCommand}"
                    CommandParameter="2022"
                    Content="{Binding Version2022ChipLabel}"
                    Opacity="{Binding VersionFilter, Converter={StaticResource ActiveOpacity}, ConverterParameter=2022}"
                    Style="{StaticResource VersionChipButtonStyle}" />
                <Button
                    Command="{Binding SetVersionFilterCommand}"
                    CommandParameter="2023"
                    Content="{Binding Version2023ChipLabel}"
                    Opacity="{Binding VersionFilter, Converter={StaticResource ActiveOpacity}, ConverterParameter=2023}"
                    Style="{StaticResource VersionChipButtonStyle}" />
                <Button
                    Command="{Binding SetVersionFilterCommand}"
                    CommandParameter="2024"
                    Content="{Binding Version2024ChipLabel}"
                    Opacity="{Binding VersionFilter, Converter={StaticResource ActiveOpacity}, ConverterParameter=2024}"
                    Style="{StaticResource VersionChipButtonStyle}" />
                <Button
                    Command="{Binding SetVersionFilterCommand}"
                    CommandParameter="2025"
                    Content="{Binding Version2025ChipLabel}"
                    Opacity="{Binding VersionFilter, Converter={StaticResource ActiveOpacity}, ConverterParameter=2025}"
                    Style="{StaticResource VersionChipButtonStyle}" />
                <Button
                    Command="{Binding SetVersionFilterCommand}"
                    CommandParameter="2026"
                    Content="{Binding Version2026ChipLabel}"
                    Opacity="{Binding VersionFilter, Converter={StaticResource ActiveOpacity}, ConverterParameter=2026}"
                    Style="{StaticResource VersionChipButtonStyle}" />
                <Button
                    Command="{Binding SetVersionFilterCommand}"
                    CommandParameter="2027"
                    Content="{Binding Version2027ChipLabel}"
                    Opacity="{Binding VersionFilter, Converter={StaticResource ActiveOpacity}, ConverterParameter=2027}"
                    Style="{StaticResource VersionChipButtonStyle}" />
            </WrapPanel>

            <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Opacity="0.5"
                    Text="{Binding EnabledFilterLabel}" />
                <Button
                    Command="{Binding SetEnabledFilterCommand}"
                    CommandParameter="{x:Static viewmodels:EnabledFilter.All}"
                    Content="{Binding EnabledAllChipLabel}"
                    Opacity="{Binding EnabledFilter, Converter={StaticResource ActiveOpacity}, ConverterParameter={x:Static viewmodels:EnabledFilter.All}}"
                    Style="{StaticResource ChipButtonStyle}" />
                <Button
                    Command="{Binding SetEnabledFilterCommand}"
                    CommandParameter="{x:Static viewmodels:EnabledFilter.Enabled}"
                    Content="{Binding EnabledOnChipLabel}"
                    Opacity="{Binding EnabledFilter, Converter={StaticResource ActiveOpacity}, ConverterParameter={x:Static viewmodels:EnabledFilter.Enabled}}"
                    Style="{StaticResource ChipButtonStyle}" />
                <Button
                    Command="{Binding SetEnabledFilterCommand}"
                    CommandParameter="{x:Static viewmodels:EnabledFilter.Disabled}"
                    Content="{Binding EnabledOffChipLabel}"
                    Opacity="{Binding EnabledFilter, Converter={StaticResource ActiveOpacity}, ConverterParameter={x:Static viewmodels:EnabledFilter.Disabled}}"
                    Style="{StaticResource ChipButtonStyle}" />
            </StackPanel>

            <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Opacity="0.5"
                    Text="{Binding SortLabel}" />
                <Button
                    Command="{Binding SetSortOrderCommand}"
                    CommandParameter="{x:Static viewmodels:ListSortOrder.Name}"
                    Content="{Binding SortNameLabel}"
                    Opacity="{Binding SortOrder, Converter={StaticResource ActiveOpacity}, ConverterParameter={x:Static viewmodels:ListSortOrder.Name}}"
                    Style="{StaticResource ChipButtonStyle}" />
                <Button
                    Command="{Binding SetSortOrderCommand}"
                    CommandParameter="{x:Static viewmodels:ListSortOrder.Scope}"
                    Content="Scope"
                    Opacity="{Binding SortOrder, Converter={StaticResource ActiveOpacity}, ConverterParameter={x:Static viewmodels:ListSortOrder.Scope}}"
                    Style="{StaticResource ChipButtonStyle}" />
                <Button
                    Command="{Binding SetSortOrderCommand}"
                    CommandParameter="{x:Static viewmodels:ListSortOrder.Version}"
                    Content="{Binding SortVersionLabel}"
                    Opacity="{Binding SortOrder, Converter={StaticResource ActiveOpacity}, ConverterParameter={x:Static viewmodels:ListSortOrder.Version}}"
                    Style="{StaticResource ChipButtonStyle}" />
                <Button
                    Margin="4,0,0,0"
                    Command="{Binding ToggleSortDirectionCommand}"
                    Content="{Binding SortDirectionGlyph}"
                    Style="{StaticResource ChipButtonStyle}"
                    ToolTip="{Binding SortDirectionTooltip}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Opacity="0.5"
                    Text="{Binding GroupLabel}" />
                <ToggleButton
                    Content="Scope"
                    IsChecked="{Binding GroupByScope, Mode=TwoWay}"
                    Style="{StaticResource ChipToggleStyle}" />
                <ToggleButton
                    Content="{Binding GroupVersionLabel}"
                    IsChecked="{Binding GroupByVersion, Mode=TwoWay}"
                    Style="{StaticResource ChipToggleStyle}" />
            </StackPanel>
        </StackPanel>

        <Border
            Margin="4"
            Padding="10,6"
            Background="{DynamicResource WarningBackgroundBrush}"
            BorderBrush="{DynamicResource WarningBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            DockPanel.Dock="Top"
            Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}">
            <TextBlock
                FontSize="11"
                Text="{Binding ErrorMessage}"
                TextWrapping="Wrap" />
        </Border>

        <Border
            Padding="10,8"
            Background="{DynamicResource CaptionHoverBrush}"
            CornerRadius="8"
            DockPanel.Dock="Bottom"
            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <!--  WrapPanel: на узкой панели команды уходят второй строкой, а не обрезаются.  -->
            <WrapPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Text="{Binding SelectionSummary}" />
                <Button
                    Command="{Binding ToggleSelectedCommand}"
                    Content="{Binding ToggleSelectedLabel}"
                    Style="{StaticResource ChipButtonStyle}" />
                <Button
                    Command="{Binding DeleteSelectedCommand}"
                    Content="{Binding DeleteSelectedLabel}"
                    Style="{StaticResource ChipButtonStyle}" />
                <Button
                    Command="{Binding ToggleSelectAllCommand}"
                    Content="{Binding SelectAllToggleLabel}"
                    Style="{StaticResource ChipButtonStyle}" />
            </WrapPanel>
        </Border>

        <ListBox
            Padding="0,0,12,0"
            Background="Transparent"
            BorderThickness="0"
            ItemTemplate="{StaticResource RowTemplate}"
            ItemsSource="{Binding FilesView}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
            SelectionMode="Extended"
            behaviors:RightClickSelectionBehavior.Enabled="True">
            <ListBox.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem
                        Command="{Binding RefreshManualCommand}"
                        Header="{Binding RefreshMenuLabel}" />
                    <MenuItem
                        Command="{Binding AddFileCommand}"
                        Header="{Binding AddFileMenuLabel}" />
                </ContextMenu>
            </ListBox.ContextMenu>
            <!--  Контекстные хоткеи списка: висят на самом ListBox, а не на окне, — фокус в поиске
                  и фильтрах их не ловит, фокус в записях уходит аналогам EntriesView.  -->
            <ListBox.InputBindings>
                <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
                <KeyBinding
                    Key="A"
                    Command="{Binding ToggleSelectAllCommand}"
                    Modifiers="Control" />
            </ListBox.InputBindings>
            <ListBox.ItemContainerStyle>
                <Style BasedOn="{StaticResource RowContainerStyle}" TargetType="ListBoxItem">
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="8,14,0,4"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Opacity="0.5"
                                Text="{Binding Name}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
        </ListBox>
    </DockPanel>
</UserControl>









