<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AddinManager.Launcher.Controls">
    <!--
        Иконка общего словаря: вид выбирает Kind (шаблон Icon.{Kind} ищется
        в Resources/Icons.xaml выше), цвет наследуется из Foreground носителя.
        Размер и Focusable — здесь; вид задаёт свои только для нестандартного размера.
    -->
    <Style TargetType="{x:Type controls:PackIcon}">
        <Setter Property="Width" Value="{DynamicResource IconSize}" />
        <Setter Property="Height" Value="{DynamicResource IconSize}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PackIcon}">
                    <ContentControl
                        x:Name="PART_Icon"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Focusable="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
