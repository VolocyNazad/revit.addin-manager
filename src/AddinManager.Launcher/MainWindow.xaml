<Window
    x:Class="AddinManager.Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:composition="clr-namespace:AddinManager.Launcher.Composition"
    xmlns:controls="clr-namespace:AddinManager.Launcher.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:design="clr-namespace:AddinManager.Launcher.Design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:AddinManager.Launcher.ViewModels"
    Title="Revit Addin Manager"
    Width="1250"
    Height="720"
    d:DataContext="{d:DesignInstance Type=design:DesignMainViewModel,
                                     IsDesignTimeCreatable=True}"
    Background="{DynamicResource AppBackgroundBrush}"
    Foreground="{DynamicResource AppForegroundBrush}"
    Icon="Resources/Icon.ico"
    ResizeMode="CanResize"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CaptionHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="CloseCaptionButton"
            BasedOn="{StaticResource CaptionButton}"
            TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CaptionCloseHoverBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="40"
            CornerRadius="8,8,8,8"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <!--  Хоткеи коллекций (v1): команды живут в зонных ViewModel, главное окно их не агрегирует
          (см. MainViewModel) — биндимся к DataContext синглтон-видов из контейнера через ViewModelLocator.
          Delete/Ctrl+A сюда не входят: они контекстные и висят на самих списках (см. ListView/EntriesView).  -->
    <Window.InputBindings>
        <KeyBinding
            Key="N"
            Command="{Binding DataContext.AddFileCommand, Source={composition:ViewModelLocator {x:Type viewmodels:ListViewModel}}}"
            Modifiers="Control" />
        <KeyBinding
            Key="F5"
            Command="{Binding DataContext.RefreshManualCommand, Source={composition:ViewModelLocator {x:Type viewmodels:ListViewModel}}}" />
        <KeyBinding
            Key="R"
            Command="{Binding DataContext.RefreshManualCommand, Source={composition:ViewModelLocator {x:Type viewmodels:ListViewModel}}}"
            Modifiers="Control" />
        <KeyBinding
            Key="E"
            Command="{Binding DataContext.ToggleSelectedCommand, Source={composition:ViewModelLocator {x:Type viewmodels:ListViewModel}}}"
            Modifiers="Control" />
        <KeyBinding
            Key="O"
            Command="{Binding DataContext.ShowInFolderCommand, Source={composition:ViewModelLocator {x:Type viewmodels:ListViewModel}}}"
            Modifiers="Control" />
        <KeyBinding
            Key="Insert"
            Command="{Binding DataContext.AddEntryCommand, Source={composition:ViewModelLocator {x:Type viewmodels:EntriesViewModel}}}" />
        <KeyBinding
            Key="N"
            Command="{Binding DataContext.AddEntryCommand, Source={composition:ViewModelLocator {x:Type viewmodels:EntriesViewModel}}}"
            Modifiers="Control+Shift" />
        <!--  Проверка обновлений: команда живёт в MainViewModel — он же DataContext окна.  -->
        <KeyBinding
            Key="U"
            Command="{Binding CheckForUpdatesCommand}"
            Modifiers="Control" />
        <!--  Сохранение редактора: роутер видимой панели (см. EditorViewModel.SaveActive).  -->
        <KeyBinding
            Key="S"
            Command="{Binding DataContext.SaveActiveCommand, Source={composition:ViewModelLocator {x:Type viewmodels:EditorViewModel}}}"
            Modifiers="Control" />
        <!--  Раскладка окна: команды в MainViewModel — он же DataContext окна.  -->
        <KeyBinding
            Key="D1"
            Command="{Binding SetMainLayoutCommand}"
            CommandParameter="{x:Static viewmodels:MainLayout.List}"
            Modifiers="Control" />
        <KeyBinding
            Key="D2"
            Command="{Binding SetMainLayoutCommand}"
            CommandParameter="{x:Static viewmodels:MainLayout.Split}"
            Modifiers="Control" />
        <KeyBinding
            Key="D3"
            Command="{Binding SetMainLayoutCommand}"
            CommandParameter="{x:Static viewmodels:MainLayout.Editor}"
            Modifiers="Control" />
        <!--  Режимы редактора: только одиночные (комбинированные — мышью); команды в EditorViewModel.  -->
        <KeyBinding
            Key="D1"
            Command="{Binding DataContext.SetEditorModeCommand, Source={composition:ViewModelLocator {x:Type viewmodels:EditorViewModel}}}"
            CommandParameter="{x:Static viewmodels:EditorMode.Entries}"
            Modifiers="Alt" />
        <KeyBinding
            Key="D2"
            Command="{Binding DataContext.SetEditorModeCommand, Source={composition:ViewModelLocator {x:Type viewmodels:EditorViewModel}}}"
            CommandParameter="{x:Static viewmodels:EditorMode.Form}"
            Modifiers="Alt" />
        <KeyBinding
            Key="D3"
            Command="{Binding DataContext.SetEditorModeCommand, Source={composition:ViewModelLocator {x:Type viewmodels:EditorViewModel}}}"
            CommandParameter="{x:Static viewmodels:EditorMode.Markup}"
            Modifiers="Alt" />
        <KeyBinding
            Key="D4"
            Command="{Binding DataContext.SetEditorModeCommand, Source={composition:ViewModelLocator {x:Type viewmodels:EditorViewModel}}}"
            CommandParameter="{x:Static viewmodels:EditorMode.Settings}"
            Modifiers="Alt" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Хром + тулбар: шапка окна и есть зона тулбара  -->
        <Grid
            x:Name="TitleBar"
            Grid.Row="0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Grid.Column="0"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Image
                    Width="38"
                    Height="38"
                    Margin="0,4,8,0"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Source="Resources/Icon.png" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="Revit Addin Manager" />
                <ContentControl
                    x:Name="ToolbarHost"
                    Margin="12,0,0,0"
                    Content="{composition:ViewModelLocator {x:Type viewmodels:ToolbarViewModel}}" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                WindowChrome.IsHitTestVisibleInChrome="True">
                <Button
                    x:Name="ShowListButton"
                    Command="{Binding SetMainLayoutCommand}"
                    CommandParameter="{x:Static viewmodels:MainLayout.List}"
                    Style="{StaticResource LayoutIconButton}"
                    ToolTip="{Binding ListOnlyTooltip}">
                    <controls:PackIcon
                        Kind="List" />
                </Button>
                <Button
                    x:Name="ShowSplitButton"
                    Margin="4,0,0,0"
                    Command="{Binding SetMainLayoutCommand}"
                    CommandParameter="{x:Static viewmodels:MainLayout.Split}"
                    Style="{StaticResource LayoutIconButton}"
                    ToolTip="{Binding SplitTooltip}">
                    <controls:PackIcon
                        Kind="Split" />
                </Button>
                <Button
                    x:Name="ShowEditorButton"
                    Margin="4,0,0,0"
                    Command="{Binding SetMainLayoutCommand}"
                    CommandParameter="{x:Static viewmodels:MainLayout.Editor}"
                    Style="{StaticResource LayoutIconButton}"
                    ToolTip="{Binding EditorOnlyTooltip}">
                    <controls:PackIcon
                        Kind="Editor" />
                </Button>
                <Button
                    x:Name="CycleThemeButton"
                    Margin="8,0,0,0"
                    Command="{Binding CycleThemeCommand}"
                    Style="{StaticResource LayoutIconButton}"
                    ToolTip="{Binding ThemeButtonTooltip}">
                    <controls:PackIcon
                        Kind="Theme" />
                </Button>
                <Button
                    x:Name="CycleLanguageButton"
                    Margin="4,0,0,0"
                    Command="{Binding CycleLanguageCommand}"
                    Style="{StaticResource LayoutIconButton}"
                    ToolTip="{Binding LanguageButtonTooltip}">
                    <controls:PackIcon
                        Kind="Language" />
                </Button>
                <Button
                    x:Name="CheckUpdatesButton"
                    Margin="4,0,0,0"
                    Command="{Binding CheckForUpdatesCommand}"
                    Style="{StaticResource LayoutIconButton}"
                    ToolTip="{Binding UpdateButtonTooltip}">
                    <controls:PackIcon
                        Kind="Update" />
                </Button>
                <Button
                    x:Name="SupportButton"
                    Margin="4,0,0,0"
                    Command="{Binding OpenSupportCommand}"
                    Style="{StaticResource LayoutIconButton}"
                    ToolTip="{Binding SupportButtonTooltip}">
                    <controls:PackIcon
                        Kind="Support" />
                </Button>
                <Button
                    x:Name="SponsorButton"
                    Margin="4,0,0,0"
                    Command="{Binding OpenSponsorCommand}"
                    Style="{StaticResource LayoutIconButton}"
                    ToolTip="{Binding SponsorButtonTooltip}">
                    <controls:PackIcon
                        Kind="Sponsor" />
                </Button>
            </StackPanel>
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                WindowChrome.IsHitTestVisibleInChrome="True">
                <Button
                    x:Name="MinButton"
                    Click="OnMinimize"
                    Content="&#xE921;"
                    Style="{StaticResource CaptionButton}" />
                <Button
                    x:Name="MaxButton"
                    Click="OnMaxRestore"
                    Content="&#xE922;"
                    Style="{StaticResource CaptionButton}" />
                <Button
                    x:Name="CloseButton"
                    Click="OnClose"
                    Content="&#xE8BB;"
                    Style="{StaticResource CloseCaptionButton}" />
            </StackPanel>
        </Grid>

        <!--  Зоны: список и редактор  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="3*" />
                <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="EditorColumn" Width="2*" />
            </Grid.ColumnDefinitions>
            <!--  Зона: группы + список файлов (контент позже)  -->
            <ContentControl x:Name="ListHost" Content="{composition:ViewModelLocator {x:Type viewmodels:ListViewModel}}" />

            <GridSplitter
                x:Name="PaneSplitter"
                Grid.Column="1"
                Width="5"
                Margin="0,4,0,4"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                DragCompleted="OnPaneSplitterDragCompleted">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>
            <!--  Зона: редактор  -->
            <ContentControl
                x:Name="EditorHost"
                Grid.Column="2"
                Content="{composition:ViewModelLocator {x:Type viewmodels:EditorViewModel}}" />

            <!--  Верхние уведомления поверх зон (раскладку не сдвигают): баннер Revit, ниже — тост.  -->
            <StackPanel
                Grid.ColumnSpan="3"
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">
                <Border
                    Padding="14,8"
                    CornerRadius="10"
                    Style="{StaticResource WarningCardStyle}"
                    Visibility="{Binding ShowRevitWarning, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            MaxWidth="440"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="{Binding RevitWarningText}"
                            TextWrapping="Wrap" />
                        <Button
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding DismissRevitWarningCommand}"
                            Content="×"
                            FontSize="11"
                            Style="{StaticResource LayoutIconButton}"
                            ToolTip="{Binding DismissRevitWarningTooltip}" />
                    </StackPanel>
                </Border>
                <Border
                    Margin="0,8,0,0"
                    Padding="14,8"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource AppBackgroundBrush}"
                    BorderBrush="{DynamicResource CaptionHoverBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        MaxWidth="480"
                        FontSize="12"
                        Text="{Binding ToastMessage}"
                        TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>




