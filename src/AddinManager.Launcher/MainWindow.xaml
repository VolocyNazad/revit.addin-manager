<Window
    x:Class="AddinManager.Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:composition="clr-namespace:AddinManager.Launcher.Composition"
    xmlns:controls="clr-namespace:AddinManager.Launcher.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:design="clr-namespace:AddinManager.Launcher.Design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:AddinManager.Launcher.ViewModels"
    Title="Revit Addin Manager"
    Width="1250"
    Height="720"
    d:DataContext="{d:DesignInstance Type=design:DesignMainViewModel,
                                     IsDesignTimeCreatable=True}"
    Background="{DynamicResource AppBackgroundBrush}"
    Foreground="{DynamicResource AppForegroundBrush}"
    Icon="Resources/ApplicationIcon.ico"
    ResizeMode="CanResize"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <SolidColorBrush x:Key="AppIconMarkBrush" Color="#45CDFF" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CaptionHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="CloseCaptionButton"
            BasedOn="{StaticResource CaptionButton}"
            TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="40"
            CornerRadius="8,8,8,8"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <!--  Хоткеи коллекций (v1): команды живут в зонных ViewModel, главное окно их не агрегирует
          (см. MainViewModel) — биндимся к DataContext синглтон-видов из контейнера через ViewModelLocator.
          Delete/Ctrl+A сюда не входят: они контекстные и висят на самих списках (см. ListView/EntriesView).  -->
    <Window.InputBindings>
        <KeyBinding
            Key="N"
            Command="{Binding DataContext.AddFileCommand, Source={composition:ViewModelLocator {x:Type viewmodels:ListViewModel}}}"
            Modifiers="Control" />
        <KeyBinding
            Key="F5"
            Command="{Binding DataContext.RefreshManualCommand, Source={composition:ViewModelLocator {x:Type viewmodels:ListViewModel}}}" />
        <KeyBinding
            Key="R"
            Command="{Binding DataContext.RefreshManualCommand, Source={composition:ViewModelLocator {x:Type viewmodels:ListViewModel}}}"
            Modifiers="Control" />
        <KeyBinding
            Key="E"
            Command="{Binding DataContext.ToggleSelectedCommand, Source={composition:ViewModelLocator {x:Type viewmodels:ListViewModel}}}"
            Modifiers="Control" />
        <KeyBinding
            Key="O"
            Command="{Binding DataContext.ShowInFolderCommand, Source={composition:ViewModelLocator {x:Type viewmodels:ListViewModel}}}"
            Modifiers="Control" />
        <KeyBinding
            Key="Insert"
            Command="{Binding DataContext.AddEntryCommand, Source={composition:ViewModelLocator {x:Type viewmodels:EntriesViewModel}}}" />
        <KeyBinding
            Key="N"
            Command="{Binding DataContext.AddEntryCommand, Source={composition:ViewModelLocator {x:Type viewmodels:EntriesViewModel}}}"
            Modifiers="Control+Shift" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Хром + тулбар: шапка окна и есть зона тулбара  -->
        <Grid
            x:Name="TitleBar"
            Grid.Row="0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Grid.Column="0"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Viewbox
                    Width="38"
                    Height="38"
                    Margin="0,0,8,0"
                    Stretch="Uniform">
                    <Canvas Width="32" Height="32">
                        <Path Data="M19 7C23.971 7 28 11.029 28 16C28 20.971 23.971 25 19 25C15.286 25 12.106 22.754 10.722 19.52C9.98 20.43 8.86 21 7.6 21C6.58 21 5.64 20.66 4.9 20.09C6.04 19.39 6.8 18.15 6.8 16.73C6.8 15.31 6.04 14.07 4.9 13.37C5.64 12.8 6.58 12.46 7.6 12.46C8.77 12.46 9.82 12.95 10.56 13.74C11.53 9.84 14.88 7 19 7ZM19 11C16.239 11 14 13.239 14 16C14 18.761 16.239 21 19 21C21.761 21 24 18.761 24 16C24 13.239 21.761 11 19 11ZM21.5 12.5C22.881 12.5 24 13.619 24 15C24 16.381 22.881 17.5 21.5 17.5C20.119 17.5 19 16.381 19 15C19 13.619 20.119 12.5 21.5 12.5ZM22 13.5C21.448 13.5 21 13.948 21 14.5C21 15.052 21.448 15.5 22 15.5C22.552 15.5 23 15.052 23 14.5C23 13.948 22.552 13.5 22 13.5Z" Fill="{StaticResource AppIconMarkBrush}" />
                    </Canvas>
                </Viewbox>
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="Revit Addin Manager" />
                <ContentControl
                    x:Name="ToolbarHost"
                    Margin="12,0,0,0"
                    Content="{composition:ViewModelLocator {x:Type viewmodels:ToolbarViewModel}}" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                WindowChrome.IsHitTestVisibleInChrome="True">
                <Button
                    x:Name="ShowListButton"
                    Command="{Binding SetMainLayoutCommand}"
                    CommandParameter="{x:Static viewmodels:MainLayout.List}"
                    Style="{StaticResource LayoutIconButton}"
                    ToolTip="{Binding ListOnlyTooltip}">
                    <controls:PackIcon
                        Width="{StaticResource IconSize}"
                        Height="{StaticResource IconSize}"
                        Focusable="False"
                        Kind="List" />
                </Button>
                <Button
                    x:Name="ShowSplitButton"
                    Margin="4,0,0,0"
                    Command="{Binding SetMainLayoutCommand}"
                    CommandParameter="{x:Static viewmodels:MainLayout.Split}"
                    Style="{StaticResource LayoutIconButton}"
                    ToolTip="{Binding SplitTooltip}">
                    <controls:PackIcon
                        Width="{StaticResource IconSize}"
                        Height="{StaticResource IconSize}"
                        Focusable="False"
                        Kind="Split" />
                </Button>
                <Button
                    x:Name="ShowEditorButton"
                    Margin="4,0,0,0"
                    Command="{Binding SetMainLayoutCommand}"
                    CommandParameter="{x:Static viewmodels:MainLayout.Editor}"
                    Style="{StaticResource LayoutIconButton}"
                    ToolTip="{Binding EditorOnlyTooltip}">
                    <controls:PackIcon
                        Width="{StaticResource IconSize}"
                        Height="{StaticResource IconSize}"
                        Focusable="False"
                        Kind="Editor" />
                </Button>
                <Button
                    x:Name="CycleThemeButton"
                    Margin="8,0,0,0"
                    Command="{Binding CycleThemeCommand}"
                    Style="{StaticResource LayoutIconButton}"
                    ToolTip="{Binding ThemeButtonTooltip}">
                    <controls:PackIcon
                        Width="{StaticResource IconSize}"
                        Height="{StaticResource IconSize}"
                        Focusable="False"
                        Kind="Theme" />
                </Button>
                <Button
                    x:Name="CycleLanguageButton"
                    Margin="4,0,0,0"
                    Command="{Binding CycleLanguageCommand}"
                    Style="{StaticResource LayoutIconButton}"
                    ToolTip="{Binding LanguageButtonTooltip}">
                    <controls:PackIcon
                        Width="{StaticResource IconSize}"
                        Height="{StaticResource IconSize}"
                        Focusable="False"
                        Kind="Language" />
                </Button>
                <Button
                    x:Name="CheckUpdatesButton"
                    Margin="4,0,0,0"
                    Command="{Binding CheckForUpdatesCommand}"
                    Style="{StaticResource LayoutIconButton}"
                    ToolTip="{Binding UpdateButtonTooltip}">
                    <controls:PackIcon
                        Width="{StaticResource IconSize}"
                        Height="{StaticResource IconSize}"
                        Focusable="False"
                        Kind="Update" />
                </Button>
                <Button
                    x:Name="SupportButton"
                    Margin="4,0,0,0"
                    Command="{Binding OpenSupportCommand}"
                    Style="{StaticResource LayoutIconButton}"
                    ToolTip="{Binding SupportButtonTooltip}">
                    <controls:PackIcon
                        Width="{StaticResource IconSize}"
                        Height="{StaticResource IconSize}"
                        Focusable="False"
                        Kind="Support" />
                </Button>
                <Button
                    x:Name="SponsorButton"
                    Margin="4,0,0,0"
                    Command="{Binding OpenSponsorCommand}"
                    Style="{StaticResource LayoutIconButton}"
                    ToolTip="{Binding SponsorButtonTooltip}">
                    <controls:PackIcon
                        Width="{StaticResource IconSize}"
                        Height="{StaticResource IconSize}"
                        Focusable="False"
                        Kind="Sponsor" />
                </Button>
            </StackPanel>
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                WindowChrome.IsHitTestVisibleInChrome="True">
                <Button
                    x:Name="MinButton"
                    Click="OnMinimize"
                    Content="&#xE921;"
                    Style="{StaticResource CaptionButton}" />
                <Button
                    x:Name="MaxButton"
                    Click="OnMaxRestore"
                    Content="&#xE922;"
                    Style="{StaticResource CaptionButton}" />
                <Button
                    x:Name="CloseButton"
                    Click="OnClose"
                    Content="&#xE8BB;"
                    Style="{StaticResource CloseCaptionButton}" />
            </StackPanel>
        </Grid>

        <!--  Зоны: список и редактор  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="3*" />
                <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="EditorColumn" Width="2*" />
            </Grid.ColumnDefinitions>
            <!--  Зона: группы + список файлов (контент позже)  -->
            <ContentControl x:Name="ListHost" Content="{composition:ViewModelLocator {x:Type viewmodels:ListViewModel}}" />

            <GridSplitter
                x:Name="PaneSplitter"
                Grid.Column="1"
                Width="5"
                Margin="0,4,0,4"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                DragCompleted="OnPaneSplitterDragCompleted">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>
            <!--  Зона: редактор  -->
            <ContentControl
                x:Name="EditorHost"
                Grid.Column="2"
                Content="{composition:ViewModelLocator {x:Type viewmodels:EditorViewModel}}" />

            <!--  Верхние уведомления поверх зон (раскладку не сдвигают): баннер Revit, ниже — тост.  -->
            <StackPanel
                Grid.ColumnSpan="3"
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">
                <Border
                    Padding="14,8"
                    Background="{DynamicResource WarningBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding ShowRevitWarning, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            MaxWidth="440"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="{Binding RevitWarningText}"
                            TextWrapping="Wrap" />
                        <Button
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding DismissRevitWarningCommand}"
                            Content="×"
                            FontSize="11"
                            Style="{StaticResource LayoutIconButton}"
                            ToolTip="{Binding DismissRevitWarningTooltip}" />
                    </StackPanel>
                </Border>
                <Border
                    Margin="0,8,0,0"
                    Padding="14,8"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource AppBackgroundBrush}"
                    BorderBrush="{DynamicResource CaptionHoverBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        MaxWidth="480"
                        FontSize="12"
                        Text="{Binding ToastMessage}"
                        TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>




