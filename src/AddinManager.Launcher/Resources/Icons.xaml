<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!--  Общие метрики иконок: один источник на все виды.  -->
    <sys:Double x:Key="IconStrokeThickness">1.2</sys:Double>
    <sys:Double x:Key="IconSize">14</sys:Double>
    <sys:Double x:Key="IconOutlineRadius">3</sys:Double>
    <sys:Double x:Key="IconLineThickness">1.4</sys:Double>
    <sys:Double x:Key="IconLineRadius">0.7</sys:Double>
    <sys:Double x:Key="IconDividerWidth">1.2</sys:Double>
    <sys:Double x:Key="IconBoxRadius">1</sys:Double>

    <!--
        Один источник на значок (дубли в видах запрещены). Каждая иконка — ControlTemplate,
        а не живой элемент: Viewbox-элемент без заданного размера "плывёт" в панелях без
        границ, а шаблон строит дерево заново на каждый ContentControl (x:Shared не нужен).
        Размер задаётся Width/Height у ContentControl на месте вставки, не внутри шаблона.
        Кисти — {DynamicResource AppForegroundBrush}: иконка не привязана к Window-предку
        и встанет в любое место дерева.
    -->

    <ControlTemplate x:Key="Icon.List" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Grid Width="{StaticResource IconSize}" Height="{StaticResource IconSize}">
                <Rectangle
                    RadiusX="{StaticResource IconOutlineRadius}"
                    RadiusY="{StaticResource IconOutlineRadius}"
                    Stroke="{DynamicResource AppForegroundBrush}"
                    StrokeThickness="{StaticResource IconStrokeThickness}" />
                <Rectangle
                    Width="8"
                    Height="{StaticResource IconLineThickness}"
                    Margin="3,4,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Fill="{DynamicResource AppForegroundBrush}"
                    RadiusX="{StaticResource IconLineRadius}"
                    RadiusY="{StaticResource IconLineRadius}" />
                <Rectangle
                    Width="8"
                    Height="{StaticResource IconLineThickness}"
                    Margin="3,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Fill="{DynamicResource AppForegroundBrush}"
                    RadiusX="{StaticResource IconLineRadius}"
                    RadiusY="{StaticResource IconLineRadius}" />
                <Rectangle
                    Width="8"
                    Height="{StaticResource IconLineThickness}"
                    Margin="3,0,0,4"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Fill="{DynamicResource AppForegroundBrush}"
                    RadiusX="{StaticResource IconLineRadius}"
                    RadiusY="{StaticResource IconLineRadius}" />
            </Grid>
        </Viewbox>
    </ControlTemplate>

    <ControlTemplate x:Key="Icon.Split" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Grid Width="{StaticResource IconSize}" Height="{StaticResource IconSize}">
                <Rectangle
                    RadiusX="{StaticResource IconOutlineRadius}"
                    RadiusY="{StaticResource IconOutlineRadius}"
                    Stroke="{DynamicResource AppForegroundBrush}"
                    StrokeThickness="{StaticResource IconStrokeThickness}" />
                <Rectangle
                    Width="{StaticResource IconDividerWidth}"
                    Margin="7.8,1.5,0,1.5"
                    HorizontalAlignment="Left"
                    Fill="{DynamicResource AppForegroundBrush}"
                    RadiusX="0.6"
                    RadiusY="0.6" />
            </Grid>
        </Viewbox>
    </ControlTemplate>

    <ControlTemplate x:Key="Icon.Editor" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Grid Width="{StaticResource IconSize}" Height="{StaticResource IconSize}">
                <Rectangle
                    RadiusX="{StaticResource IconOutlineRadius}"
                    RadiusY="{StaticResource IconOutlineRadius}"
                    Stroke="{DynamicResource AppForegroundBrush}"
                    StrokeThickness="{StaticResource IconStrokeThickness}" />
                <Rectangle
                    Width="4"
                    Height="4"
                    Margin="0,0,2,2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Fill="{DynamicResource AppForegroundBrush}"
                    RadiusX="{StaticResource IconBoxRadius}"
                    RadiusY="{StaticResource IconBoxRadius}" />
            </Grid>
        </Viewbox>
    </ControlTemplate>

    <ControlTemplate x:Key="Icon.Theme" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Grid Width="{StaticResource IconSize}" Height="{StaticResource IconSize}">
                <Ellipse
                    Width="12"
                    Height="12"
                    Stroke="{DynamicResource AppForegroundBrush}"
                    StrokeThickness="{StaticResource IconStrokeThickness}" />
                <Path Data="M7,1 A6,6 0 0 1 7,13 Z" Fill="{DynamicResource AppForegroundBrush}" />
            </Grid>
        </Viewbox>
    </ControlTemplate>

    <ControlTemplate x:Key="Icon.Form" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Grid Width="{StaticResource IconSize}" Height="{StaticResource IconSize}">
                <Rectangle
                    RadiusX="{StaticResource IconOutlineRadius}"
                    RadiusY="{StaticResource IconOutlineRadius}"
                    Stroke="{DynamicResource AppForegroundBrush}"
                    StrokeThickness="{StaticResource IconStrokeThickness}" />
                <Rectangle
                    Width="8"
                    Height="4"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    RadiusX="{StaticResource IconBoxRadius}"
                    RadiusY="{StaticResource IconBoxRadius}"
                    Stroke="{DynamicResource AppForegroundBrush}"
                    StrokeThickness="{StaticResource IconStrokeThickness}" />
                <Rectangle
                    Width="8"
                    Height="{StaticResource IconLineThickness}"
                    Margin="0,9,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Fill="{DynamicResource AppForegroundBrush}"
                    RadiusX="{StaticResource IconLineRadius}"
                    RadiusY="{StaticResource IconLineRadius}" />
            </Grid>
        </Viewbox>
    </ControlTemplate>

    <ControlTemplate x:Key="Icon.Markup" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Grid Width="{StaticResource IconSize}" Height="{StaticResource IconSize}">
                <Rectangle
                    RadiusX="{StaticResource IconOutlineRadius}"
                    RadiusY="{StaticResource IconOutlineRadius}"
                    Stroke="{DynamicResource AppForegroundBrush}"
                    StrokeThickness="{StaticResource IconStrokeThickness}" />
                <Grid
                    Width="6"
                    Height="4.5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Path
                        Data="M1.5,0 L4.5,2.25 L1.5,4.5"
                        Stroke="{DynamicResource AppForegroundBrush}"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="{StaticResource IconStrokeThickness}" />
                </Grid>
            </Grid>
        </Viewbox>
    </ControlTemplate>

    <ControlTemplate x:Key="Icon.EntriesForm" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Grid Width="{StaticResource IconSize}" Height="{StaticResource IconSize}">
                <Rectangle
                    RadiusX="{StaticResource IconOutlineRadius}"
                    RadiusY="{StaticResource IconOutlineRadius}"
                    Stroke="{DynamicResource AppForegroundBrush}"
                    StrokeThickness="{StaticResource IconStrokeThickness}" />
                <Rectangle
                    Width="{StaticResource IconDividerWidth}"
                    Margin="4.4,1.5,0,1.5"
                    HorizontalAlignment="Left"
                    Fill="{DynamicResource AppForegroundBrush}"
                    RadiusX="0.6"
                    RadiusY="0.6" />
                <Rectangle
                    Width="5"
                    Height="4"
                    Margin="7,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    RadiusX="{StaticResource IconBoxRadius}"
                    RadiusY="{StaticResource IconBoxRadius}"
                    Stroke="{DynamicResource AppForegroundBrush}"
                    StrokeThickness="{StaticResource IconStrokeThickness}" />
            </Grid>
        </Viewbox>
    </ControlTemplate>

    <ControlTemplate x:Key="Icon.EntriesMarkup" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Grid Width="{StaticResource IconSize}" Height="{StaticResource IconSize}">
                <Rectangle
                    RadiusX="{StaticResource IconOutlineRadius}"
                    RadiusY="{StaticResource IconOutlineRadius}"
                    Stroke="{DynamicResource AppForegroundBrush}"
                    StrokeThickness="{StaticResource IconStrokeThickness}" />
                <Rectangle
                    Width="{StaticResource IconDividerWidth}"
                    Margin="4.4,1.5,0,1.5"
                    HorizontalAlignment="Left"
                    Fill="{DynamicResource AppForegroundBrush}"
                    RadiusX="0.6"
                    RadiusY="0.6" />
                <Grid
                    Width="4"
                    Height="5"
                    Margin="0,0,1.5,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <Path
                        Margin="-1,0,1,0"
                        Data="M0.5,0 L3.5,2.5 L0.5,5"
                        Stroke="{DynamicResource AppForegroundBrush}"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="{StaticResource IconStrokeThickness}" />
                </Grid>
            </Grid>
        </Viewbox>
    </ControlTemplate>

    <ControlTemplate x:Key="Icon.Settings" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Grid Width="{StaticResource IconSize}" Height="{StaticResource IconSize}">
                <Rectangle
                    RadiusX="{StaticResource IconOutlineRadius}"
                    RadiusY="{StaticResource IconOutlineRadius}"
                    Stroke="{DynamicResource AppForegroundBrush}"
                    StrokeThickness="{StaticResource IconStrokeThickness}" />
                <Ellipse
                    Width="5.5"
                    Height="5.5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Stroke="{DynamicResource AppForegroundBrush}"
                    StrokeThickness="{StaticResource IconStrokeThickness}" />
                <Ellipse
                    Width="1.6"
                    Height="1.6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Fill="{DynamicResource AppForegroundBrush}" />
            </Grid>
        </Viewbox>
    </ControlTemplate>

    <!--  Круговая стрелка 300° с разрывом под наконечником; шеврон симметричен относительно Y=2.2.  -->
    <ControlTemplate x:Key="Icon.Refresh" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Grid Width="{StaticResource IconSize}" Height="{StaticResource IconSize}">
                <Path
                    Data="M11.33,4.7 A5,5 0 1 1 7,2.2"
                    Stroke="{DynamicResource AppForegroundBrush}"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="{StaticResource IconStrokeThickness}" />
                <Path
                    Data="M5.4,1.4 L7,2.2 L5.4,3"
                    Stroke="{DynamicResource AppForegroundBrush}"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="{StaticResource IconStrokeThickness}" />
            </Grid>
        </Viewbox>
    </ControlTemplate>

    <!--
        Глобус: внешняя окружность 12, меридиан-эллипс той же высоты и экватор —
        тем же штрихом, что остальные иконки.
    -->
    <ControlTemplate x:Key="Icon.Language" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Grid Width="{StaticResource IconSize}" Height="{StaticResource IconSize}">
                <Ellipse
                    Width="12"
                    Height="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Stroke="{DynamicResource AppForegroundBrush}"
                    StrokeThickness="{StaticResource IconStrokeThickness}" />
                <Ellipse
                    Width="5"
                    Height="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Stroke="{DynamicResource AppForegroundBrush}"
                    StrokeThickness="{StaticResource IconStrokeThickness}" />
                <Rectangle
                    Width="12"
                    Height="{StaticResource IconStrokeThickness}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Fill="{DynamicResource AppForegroundBrush}"
                    RadiusX="{StaticResource IconLineRadius}"
                    RadiusY="{StaticResource IconLineRadius}" />
            </Grid>
        </Viewbox>
    </ControlTemplate>
    <!--  Стрелка вниз в лоток: скачивание/обновление.  -->
    <ControlTemplate x:Key="Icon.Update" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Grid Width="{StaticResource IconSize}" Height="{StaticResource IconSize}">
                <Path
                    Data="M7,1.5 L7,8"
                    Stroke="{DynamicResource AppForegroundBrush}"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="{StaticResource IconStrokeThickness}" />
                <Path
                    Data="M4.5,5.5 L7,8 L9.5,5.5"
                    Stroke="{DynamicResource AppForegroundBrush}"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="{StaticResource IconStrokeThickness}" />
                <Path
                    Data="M2.5,11.5 L11.5,11.5"
                    Stroke="{DynamicResource AppForegroundBrush}"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="{StaticResource IconStrokeThickness}" />
            </Grid>
        </Viewbox>
    </ControlTemplate>
    <!--  Вопросительный знак: помощь/поддержка.  -->
    <ControlTemplate x:Key="Icon.Support" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Grid Width="{StaticResource IconSize}" Height="{StaticResource IconSize}">
                <Path
                    Data="M5.5,3.5 C5.5,2.6 6.2,2 7,2 C8.5,2 9.5,3.1 9.5,4.3 C9.5,5.6 8.6,6.2 7.6,6.6 L7.6,8.4"
                    Stroke="{DynamicResource AppForegroundBrush}"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="{StaticResource IconStrokeThickness}" />
                <Path
                    Data="M7.6,10.6 L7.6,11"
                    Stroke="{DynamicResource AppForegroundBrush}"
                    StrokeEndLineCap="Round"
                    StrokeThickness="{StaticResource IconStrokeThickness}" />
            </Grid>
        </Viewbox>
    </ControlTemplate>
    <!--  Сердце: спонсорство/поддержать автора.  -->
    <ControlTemplate x:Key="Icon.Sponsor" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Grid Width="{StaticResource IconSize}" Height="{StaticResource IconSize}">
                <Path Data="M7,10.5 C7,10.5 2.5,7.5 2.5,5 C2.5,3.6 3.6,2.6 5,2.6 C5.9,2.6 6.6,3.1 7,3.8 C7.4,3.1 8.1,2.6 9,2.6 C10.4,2.6 11.5,3.6 11.5,5 C11.5,7.5 7,10.5 7,10.5 Z" Fill="{DynamicResource AppForegroundBrush}" />
            </Grid>
        </Viewbox>
    </ControlTemplate>
    <!--  Урна без контура, на всю сетку: ручка, крышка и корпус со шлицами.  -->
    <ControlTemplate x:Key="Icon.Delete" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Grid Width="{StaticResource IconSize}" Height="{StaticResource IconSize}">
                <Rectangle
                    Width="3.4"
                    Height="{StaticResource IconLineThickness}"
                    Margin="0,1.2,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Fill="{DynamicResource AppForegroundBrush}"
                    RadiusX="{StaticResource IconLineRadius}"
                    RadiusY="{StaticResource IconLineRadius}" />
                <Rectangle
                    Width="9.5"
                    Height="{StaticResource IconLineThickness}"
                    Margin="0,3,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Fill="{DynamicResource AppForegroundBrush}"
                    RadiusX="{StaticResource IconLineRadius}"
                    RadiusY="{StaticResource IconLineRadius}" />
                <Rectangle
                    Width="7"
                    Height="7"
                    Margin="0,5,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    RadiusX="{StaticResource IconBoxRadius}"
                    RadiusY="{StaticResource IconBoxRadius}"
                    Stroke="{DynamicResource AppForegroundBrush}"
                    StrokeThickness="{StaticResource IconStrokeThickness}" />
                <StackPanel
                    Width="4.4"
                    Height="3.6"
                    Margin="0,6.6,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Orientation="Horizontal">
                    <Rectangle
                        Width="1.2"
                        Height="3.6"
                        Fill="{DynamicResource AppForegroundBrush}"
                        RadiusX="0.6"
                        RadiusY="0.6" />
                    <Rectangle
                        Width="1.2"
                        Height="3.6"
                        Margin="2,0,0,0"
                        Fill="{DynamicResource AppForegroundBrush}"
                        RadiusX="0.6"
                        RadiusY="0.6" />
                </StackPanel>
            </Grid>
        </Viewbox>
    </ControlTemplate>
    <!--  Крестик: два штриха с круглыми концами, тем же штрихом, что остальные иконки.  -->
    <ControlTemplate x:Key="Icon.Close" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Grid Width="{StaticResource IconSize}" Height="{StaticResource IconSize}">
                <Path
                    Data="M3.5,3.5 L10.5,10.5 M10.5,3.5 L3.5,10.5"
                    Stroke="{DynamicResource AppForegroundBrush}"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="{StaticResource IconStrokeThickness}" />
            </Grid>
        </Viewbox>
    </ControlTemplate>
    <!--
        Предупреждение: та же конструкция, что у остальных иконок (скруглённый контур +
        глиф со скруглёнными концами), но желтым — в цвет рамки предупреждающих баннеров
        (WarningBorderBrush). Прозрачный фон — не для вида, а для хит-теста: иконка стоит
        голым ContentControl (не в кнопке), и без фона тултип срабатывал бы только при
        наведении точно на штрихи.
    -->
    <ControlTemplate x:Key="Icon.Warning" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Grid
                Width="{StaticResource IconSize}"
                Height="{StaticResource IconSize}"
                Background="Transparent">
                <Rectangle
                    RadiusX="{StaticResource IconOutlineRadius}"
                    RadiusY="{StaticResource IconOutlineRadius}"
                    Stroke="#E6A700"
                    StrokeThickness="{StaticResource IconStrokeThickness}" />
                <Rectangle
                    Width="2"
                    Height="5"
                    Margin="0,3.2,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Fill="#E6A700"
                    RadiusX="1"
                    RadiusY="1" />
                <Ellipse
                    Width="2"
                    Height="2"
                    Margin="0,0,0,2.8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Fill="#E6A700" />
            </Grid>
        </Viewbox>
    </ControlTemplate>
    <!--  Плюс: два штриха с круглыми концами, тем же штрихом, что остальные иконки.  -->
    <ControlTemplate x:Key="Icon.Add" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Grid Width="{StaticResource IconSize}" Height="{StaticResource IconSize}">
                <Path
                    Data="M7,3.5 L7,10.5 M3.5,7 L10.5,7"
                    Stroke="{DynamicResource AppForegroundBrush}"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="{StaticResource IconStrokeThickness}" />
            </Grid>
        </Viewbox>
    </ControlTemplate>
    <!--
        Папка (кнопка "Показать в папке"): контур Feather Icons, штрих 2 на сетке 24 —
        во Viewbox 14 он садится в те же ~1.2, что IconStrokeThickness остальных иконок.
    -->
    <ControlTemplate x:Key="Icon.Folder" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Grid Width="24" Height="24">
                <Path
                    Data="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"
                    Stroke="{DynamicResource AppForegroundBrush}"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="2" />
            </Grid>
        </Viewbox>
    </ControlTemplate>
    <!--
        Галка пакетного выбора: залитый путь Material Design Icons ("check", сетка 24) плюс
        тонкая обводка в тот же цвет — золотая середина между худым "check" и бруском
        "check-bold" в мелком размере, рисовать свой смысла нет.
        Цвет берёт из Foreground места вставки, а не из AppForegroundBrush: в чекбоксе
        поверх заливки нужен AppBackgroundBrush, в остальных местах наследуется тема.
    -->
    <ControlTemplate x:Key="Icon.Check" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Grid Width="24" Height="24">
                <Path
                    Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                    Fill="{TemplateBinding Foreground}"
                    Stroke="{TemplateBinding Foreground}"
                    StrokeLineJoin="Round"
                    StrokeThickness="1" />
            </Grid>
        </Viewbox>
    </ControlTemplate>
</ResourceDictionary>

