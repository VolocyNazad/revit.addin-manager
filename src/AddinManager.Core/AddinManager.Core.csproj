<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AddinManager.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!--
      resx лежат рядом с классом и отображаются вложенными под него в Solution
      Explorer: нейтральный (английский) — под Class.cs как есть, культурный
      (Class.ru.resx) — со срезанным суффиксом культуры.
    -->
    <EmbeddedResource Update="**\*.resx">
      <DependentUpon>$([System.Text.RegularExpressions.Regex]::Replace('%(Filename)', '\.[a-z]{2}(-[A-Z]{2})?$', '')).cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

</Project>
